+ImVec2 BezierPoint(const ImCubicBezierPoints& c, float t) {
+    float u = 1.0f - t;
+    float tt = t * t;
+    float uu = u * u;
+    float uuu = uu * u;
+    float ttt = tt * t;
+
+    ImVec2 p = c.P0 * uuu;        // (1-t)^3 * P0
+    p += c.P1 * 3 * uu * t;       // 3(1-t)^2 * t * P1
+    p += c.P2 * 3 * u * tt;       // 3(1-t) * t^2 * P2
+    p += c.P3 * ttt;              // t^3 * P3
+    return p;
+}
