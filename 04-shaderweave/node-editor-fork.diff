+//------------------------------------------------------------------------------
+/////////////// NOTE ///////////////////////////////////////////////////////////
+// not using this, using a more advanced one
+// this one is not working properly (Bowtie)
+//------------------------------------------------------------------------------
+void DrawTaperedBezier(ImDrawList* drawList, const ImCubicBezierPoints& curve,
+    float widthStart, float widthEnd, ImU32 color)
+{
+    const int segments = 48; // Higher = smoother
+    std::vector<ImVec2> left, right;
+
+    for (int i = 0; i < segments; ++i)
+    {
+        float t = float(i) / (segments - 1);
+        ImVec2 pt = BezierPoint(curve, t);
+
+        // Compute direction (finite difference)
+        float delta = 1.0f / (segments - 1);
+        float t0 = ImClamp(t - delta, 0.0f, 1.0f);
+        float t1 = ImClamp(t + delta, 0.0f, 1.0f);
+        ImVec2 dir = BezierPoint(curve, t1) - BezierPoint(curve, t0);
+        float len = sqrtf(dir.x * dir.x + dir.y * dir.y);
+        if (len == 0) dir = ImVec2(1, 0); // Fallback
+        else          dir /= len;
+
+        // Normal direction (flip sign if shape is inside-out)
+        ImVec2 normal = ImVec2(dir.y, -dir.x);
+
+        float w = widthStart * (1.0f - t) + widthEnd * t;
+        left.push_back(pt - normal * (w * 0.2f));
+        right.push_back(pt + normal * (w * 0.2f));
+
+        drawList->AddPolyline(left.data(), left.size(), IM_COL32(200, 200, 200, 200), false, 1.0f);
+        drawList->AddPolyline(right.data(), right.size(), IM_COL32(200, 200, 200, 200), false, 1.0f);
+
+    }
+
+    for (int i = 0; i < segments - 1; ++i)
+    {
+        ImVec2 quad[4] = {
+            left[i],
+            left[i + 1],
+            right[i + 1],
+            right[i]
+        };
+        drawList->AddConvexPolyFilled(quad, 4, color); // 4 points = quad (always convex)
+    }
+}
