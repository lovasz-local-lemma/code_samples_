+    // Outward normals
+    std::vector<ImVec2> normals(N);
+    for (int i = 0; i < N; ++i) {
+        ImVec2 p0 = border[(i - 1 + N) % N];
+        ImVec2 p1 = border[(i + 1) % N];
+        ImVec2 tangent = ImVec2(p1.x - p0.x, p1.y - p0.y);
