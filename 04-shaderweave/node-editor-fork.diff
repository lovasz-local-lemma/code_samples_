+//------------------------------------------------------------------------------
+/////////////// PULSING RUBBON /////////////// 
+// The one actually in use.
+// Pulsing ribbon
+//------------------------------------------------------------------------------
+
+void DrawTaperedBezierWithPulse(ImDrawList* drawList, const ImCubicBezierPoints& curve,
+    float startWidth, float endWidth, ImU32 baseColor, float pulseSpeed, float phase)
+{
+    const int segments = 48;
+    std::vector<ImVec2> left, right;
+
+    // Pulse center t (moves along the ribbon)
+    float time = ImGui::GetTime();
+    float pulsePos = fmod(time * pulseSpeed + phase, 1.0f);
+
+    for (int i = 0; i < segments; ++i)
+    {
+        float t = float(i) / (segments - 1);
+        ImVec2 pt = BezierPoint(curve, t);
+
+        // Forward difference for direction (prevents flip)
+        ImVec2 dir;
+        if (i < segments - 1)
+            dir = BezierPoint(curve, float(i + 1) / (segments - 1)) - pt;
+        else
+            dir = pt - BezierPoint(curve, float(i - 1) / (segments - 1));
+        float len = sqrtf(dir.x * dir.x + dir.y * dir.y);
+        dir = (len > 0.0f) ? dir / len : ImVec2(1, 0);
+        ImVec2 normal = ImVec2(-dir.y, dir.x);
+
+        // --- Pulse effect (Gaussian envelope) ---
+        float pulseDist = fabsf(t - pulsePos);
+        // Loop around if crossing boundary
+        if (pulseDist > 0.5f) pulseDist = 1.0f - pulseDist;
+        float pulse = expf(-pulseDist * pulseDist * 48.0f); // controls sharpness
+
+        float width = (startWidth * (1.0f - t) + endWidth * t) * (1.0f + 0.6f * pulse);
+        left.push_back(pt - normal * (width * 0.5f));
+        right.push_back(pt + normal * (width * 0.5f));
+    }
+
+    // Draw quad segments with color pulse
+    for (int i = 0; i < segments - 1; ++i)
+    {
+        float t0 = float(i) / (segments - 1);
+        float t1 = float(i + 1) / (segments - 1);
+
+        // Pulse for color
+        float pulseDist0 = fabsf(t0 - pulsePos);
+        float pulseDist1 = fabsf(t1 - pulsePos);
+        if (pulseDist0 > 0.5f) pulseDist0 = 1.0f - pulseDist0;
+        if (pulseDist1 > 0.5f) pulseDist1 = 1.0f - pulseDist1;
+        float colorPulse0 = expf(-pulseDist0 * pulseDist0 * 42.0f);
+        float colorPulse1 = expf(-pulseDist1 * pulseDist1 * 42.0f);
+
+        // Build color pulse: baseColor plus white/blue highlight
+        ImVec4 cBase = ImGui::ColorConvertU32ToFloat4(baseColor);
+        ImVec4 cPulse0 = cBase;
+        cPulse0.x = ImMin(1.0f, cBase.x + 0.4f * colorPulse0);
+        cPulse0.y = ImMin(1.0f, cBase.y + 0.4f * colorPulse0);
+        cPulse0.z = ImMin(1.0f, cBase.z + 0.7f * colorPulse0);
+        cPulse0.w = ImMin(1.0f, cBase.w + 0.5f * colorPulse0);
+
+        ImU32 segColor = ImGui::ColorConvertFloat4ToU32(cPulse0);
+
+        // Draw ribbon segment
+        ImVec2 quad[4] = { left[i], left[i + 1], right[i + 1], right[i] };
+        drawList->AddConvexPolyFilled(quad, 4, segColor);
+    }
+
+    // Optionally: Draw left/right outlines for debugging
+     drawList->AddPolyline(left.data(), left.size(), IM_COL32(0,60,240,150), false, 0.5f);
+     drawList->AddPolyline(right.data(), right.size(), IM_COL32(255,0,0,100), false, 0.2f);
+}
