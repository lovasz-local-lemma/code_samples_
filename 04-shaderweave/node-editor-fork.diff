+ImVec2 GetRoundedRectBorderPoint(const ImRect& rect, float radius, float t) {
+    // t in [0, 1)
+    float width = rect.Max.x - rect.Min.x;
+    float height = rect.Max.y - rect.Min.y;
+    float len0 = width - 2 * radius;      // Top
+    float len1 = height - 2 * radius;     // Right
+    float len2 = width - 2 * radius;      // Bottom
+    float len3 = height - 2 * radius;     // Left
+    float arc = IM_PI * 0.5f * radius;    // Each corner arc
+    float total = len0 + len1 + len2 + len3 + 4 * IM_PI * 0.5f * radius;
+
+    float d = t * total;
+    ImVec2 p;
+
+    // Top edge
+    if (d < len0) {
+        p = ImVec2(rect.Min.x + radius + d, rect.Min.y);
+    }
+    else if ((d -= len0) < arc) { // Top-right arc
+        float angle = -IM_PI * 0.5f + (d / arc) * IM_PI * 0.5f;
+        p = ImVec2(rect.Max.x - radius + radius * cosf(angle), rect.Min.y + radius + radius * sinf(angle));
+    }
+    else if ((d -= arc) < len1) { // Right edge
+        p = ImVec2(rect.Max.x, rect.Min.y + radius + d);
+    }
+    else if ((d -= len1) < arc) { // Bottom-right arc
+        float angle = 0 + (d / arc) * IM_PI * 0.5f;
+        p = ImVec2(rect.Max.x - radius + radius * cosf(angle), rect.Max.y - radius + radius * sinf(angle));
+    }
+    else if ((d -= arc) < len2) { // Bottom edge
+        p = ImVec2(rect.Max.x - radius - d, rect.Max.y);
+    }
+    else if ((d -= len2) < arc) { // Bottom-left arc
+        float angle = IM_PI * 0.5f + (d / arc) * IM_PI * 0.5f;
+        p = ImVec2(rect.Min.x + radius + radius * cosf(angle), rect.Max.y - radius + radius * sinf(angle));
+    }
+    else if ((d -= arc) < len3) { // Left edge
+        p = ImVec2(rect.Min.x, rect.Max.y - radius - d);
+    }
+    else { // Top-left arc
+        d -= len3;
+        float angle = IM_PI + (d / arc) * IM_PI * 0.5f;
+        p = ImVec2(rect.Min.x + radius + radius * cosf(angle), rect.Min.y + radius + radius * sinf(angle));
+    }
+    return p;
+}
