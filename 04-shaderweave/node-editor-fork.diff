+        float bump = 8.0f * powf(ImClamp(1.0f - dt * 6.0f, 0.0f, 1.0f), 4.0f)+2.0;
+        float wobble = sinf(time * 2.2f + t * 11.0f) * 2.8f + cosf(time * 1.2f + t * 7.3f) * 1.2f;
