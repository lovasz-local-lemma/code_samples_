+            assert(valid);
+            Box3f box;
+
+            if (has_longedge)
+                return bounds_inf();
+
+            box.grow(origin);
+            box.grow(origin + V[0] * mpx[0]);
+            box.grow(origin + V[1] * mpx[1]);
+            box.grow(origin + V[0] * mpx[0] + V[1] * mpx[1]);
+
+            return box;
+        }
