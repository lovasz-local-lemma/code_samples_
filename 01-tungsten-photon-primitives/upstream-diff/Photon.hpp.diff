+        static void ray_from_to(const Vec3f &p1, const Vec3f &p2, Ray &ra)
+        {
+            Vec3f dif = (p2 - p1);
+            Vec3f difd = dif.normalized();
+
+            if (isnan(difd[0]))
+            {
+                difd = one_sq3;
+            }
+
+            ra.setPos(p1);
