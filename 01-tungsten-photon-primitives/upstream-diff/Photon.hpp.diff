+    struct DifferentialPhotonPlane_unidir
+    {
+        bool longprim = true;
+        Vec3f p0;
+        Vec3f ep0, ep1;
+        Vec3f d0, d1;
+        Vec3f ep0E, ep1E;
+        float len;
+
+        int bounce;
+        bool valid;
+
+        void longprim_ext()
+        {
+            if (longprim)
+            {
+                len = 1000;
+            }
+        }
+
+        void ext()
+        {
+            d0 = (ep0 - p0).normalized();
+            d1 = (ep1 - p0).normalized();
+
+            ep0E = len * d0 + p0;
+            ep1E = len * d1 + p0;
+        }
+
+        Box3f bounds() const
+        {
+            Box3f box;
+            box.grow(p0);
+            box.grow(ep0E);
+            box.grow(ep1E);
+            box.grow(ep0E + len * d1);
+            return box;
+        }
+    };
+
+    struct DifferentialPhotonPlane_bidir
+    {
+        bool longprim = true;
+        Vec3f p0, p1;
+        Vec3f dir;
+        float len;
+
+        Vec3f LB, LT, RB, RT;
+
+        void longprim_ext()
+        {
+            if (longprim)
+            {
+                len = 1000;
+            }
+        }
+
+        int bounce;
+        bool valid;
+
+        void ext()
+        {
+            LB = p0 - len * dir;
+            LT = p0 + len * dir;
+            RB = p1 - len * dir;
+            RT = p1 + len * dir;
+        }
+
+        Box3f bounds() const
+        {
+            Box3f box;
+            box.grow(LB);
+            box.grow(LT);
+            box.grow(RB);
+            box.grow(RT);
+            return box;
+        }
+    };
