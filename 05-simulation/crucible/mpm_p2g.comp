                       * (1.0 + pseudo_depth * (0.10 + 0.18 * core_seed));
        float nu_ts = clamp(mix(0.34, 0.22, dry), 0.14, 0.40);
        float mu_ts = E_ts / (2.0 * (1.0 + nu_ts));
        float lam_ts = E_ts * nu_ts / ((1.0 + nu_ts) * (1.0 - 2.0 * nu_ts));
        float J_rest = 1.0 + weak * 0.05 * (1.0 + 0.10 * pseudo_depth) - dry * (0.028 + 0.010 * shell_seed);

        stress = 2.0 * mu_ts * (F - R) * transpose(F)
               + lam_ts * (J - J_rest) * J * mat2(1.0);
        if (fs > 1e-6) {
            vec2 fh = df / fs;
            float fi = clamp(fs - 1.0, -0.18, 0.30);
            stress += fiber_strength * mu_ts * (0.48 + dry * 0.62) * fi * mat2(
                fh.x*fh.x, fh.x*fh.y, fh.y*fh.x, fh.y*fh.y);
        }

        float tear_thresh = (mix(0.40, 0.14, brittle) - weak * mix(0.05, 0.13, micro)) * pseudo_split_hold
                          + pseudo_shell * 0.05;
        float tear_rate = mix(0.10, 2.4, brittle) * (1.0 + weak * 1.8) * mix(1.0, 0.68, clamp(pseudo_cohesion * 0.75, 0.0, 1.0));
        float tear_drive = max(across * 1.35 + along * 0.55 + weak * 0.22 - tear_thresh, 0.0);
        tear += tear_drive * tear_rate * u_dt;
        tear = clamp(tear, 0.0, 1.0);
        if (tear > 0.50) {
            weak *= max(1.0 - mix(0.70, 0.42, clamp(pseudo_enclosure * 0.80, 0.0, 1.0)) * u_dt, 0.0);
        }

        damage[idx] = dry;
        phase_data[idx] = weak;
        Jp_data[idx] = tear;

        float tear_soften = mix(0.68, 0.48, clamp(pseudo_cohesion * 0.75, 0.0, 1.0));
        stress *= max(1.0 - tear * tear_soften, 0.22 + 0.10 * clamp(pseudo_depth * 0.60, 0.0, 1.0));
        if (tear > 0.32) {
            float vent = smoothstep(0.32, 1.0, tear);
            stress *= mix(1.0, mix(0.18, 0.36, clamp(pseudo_cohesion * 0.75, 0.0, 1.0)), vent);
        }
