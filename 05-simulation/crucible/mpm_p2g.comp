                       * mix(1.0, pseudo_shell_boost, 0.18 + 0.42 * fired)
                       * (1.0 + pseudo_depth * 0.16);
        float nu_sw = clamp(mix(0.22, 0.18, fired), 0.14, 0.28);
        float mu_sw = E_sw / (2.0 * (1.0 + nu_sw));
        float lam_sw = E_sw * nu_sw / ((1.0 + nu_sw) * (1.0 - 2.0 * nu_sw));
        float J_rest = 1.0 + shrink * (use_bp ? (bpA.y * bpB.x) : -(0.14 + 0.10 * shell_seed));
        if (use_bp) J_rest = clamp(J_rest, 0.74, 3.0);

