#version 450 core

// MLS-MPM Particle-to-Grid with constitutive models and thermal variants

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer PositionBuffer  { vec2  positions[];     };
layout(std430, binding = 1) readonly buffer VelocityBuffer  { vec2  velocities[];    };
layout(std430, binding = 2) readonly buffer MassBuffer      { float masses[];        };
layout(std430, binding = 4) buffer DeformGradBuffer         { vec4  deform_grads[];  };
layout(std430, binding = 5) buffer AffineMomBuffer          { vec4  affine_moms[];   };
layout(std430, binding = 6) buffer TempBuffer               { float temperatures[];  };
layout(std430, binding = 7) readonly buffer MatIDBuffer     { uint  material_ids[];  };

layout(std430, binding = 47) buffer JpBuffer      { float Jp_data[];     };
layout(std430, binding = 48) buffer FiberBuffer   { vec2  fiber_dirs[];  };
layout(std430, binding = 49) buffer DamageBuffer  { float damage[];      };
layout(std430, binding = 50) buffer PhaseBuffer   { float phase_data[];  };
layout(std430, binding = 51) readonly buffer MatParams0 { vec4 mat_params0[]; };

layout(std430, binding = 40) coherent buffer GridMass    { int grid_mass[];     };
layout(std430, binding = 41) coherent buffer GridMomX    { int grid_mom_x[];    };
layout(std430, binding = 42) coherent buffer GridMomY    { int grid_mom_y[];    };
layout(std430, binding = 55) coherent buffer GridTempAto { int grid_temp_ato[]; };
layout(binding = 0) uniform sampler2D u_sdf_tex;
layout(binding = 1) uniform sampler2D u_magnetic_drive_tex;
layout(binding = 2) uniform sampler2D u_magnetic_total_tex;
layout(binding = 3) uniform sampler2D u_magnetic_material_tex;
layout(binding = 4) uniform samplerBuffer u_thermal_coupling_tex;
// Oxygen field, sampled to gate combustion.
layout(binding = 5) uniform sampler2D u_oxygen_tex;
// Bake Profile v1: per-material-ID profile LUT (3 RGBA32F texels/id), keyed by
// material id, not particle idx. Only fetched under the u_bake_profiles guard, so an
// unbound LUT can never touch the off path.
layout(binding = 6) uniform samplerBuffer u_bake_profile_tex;
// Aniso Fracture v1: per-material fracture profile LUT on unit 7, plus the
// per-particle aux imageBuffer (x = D_tilde history, y = Lap(d)). Image uniforms
// live in a SEPARATE binding namespace from std430 blocks, so this adds nothing to
// the 16-SSBO cap that this shader already sits at.
layout(binding = 7) uniform samplerBuffer u_fracture_profile_tex;
layout(binding = 0, rgba32f) uniform coherent restrict imageBuffer u_frac_aux;
uniform int  u_fire_oxygen;
uniform int  u_fire_smolder;
uniform int  u_fire_structural;
uniform float u_smolder_o2_lo;
uniform float u_char_fracture_gain;
uniform vec2 u_air_world_min;
uniform vec2 u_air_world_max;
float sample_oxygen(vec2 wp) {
    if (u_fire_oxygen == 0) return 1.0;
    vec2 uv = (wp - u_air_world_min) / (u_air_world_max - u_air_world_min);
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return 1.0;
    return clamp(texture(u_oxygen_tex, uv).r, 0.0, 1.0);
}

const float FIXED_SCALE = 1000000.0;

uniform uint  u_offset, u_count;
uniform float u_dx, u_dt, u_p_vol;
uniform vec2  u_grid_origin;
uniform ivec2 u_grid_res;
uniform float u_E, u_nu, u_fiber_strength;
uniform float u_fracture_threshold, u_fracture_rate;
uniform float u_melt_temp, u_melt_range, u_latent_heat;
uniform int   u_enable_pseudo_25d;
uniform int   u_real_25d;   // Real 2.5D z-occupancy; 0 = off
uniform float u_pseudo_25d_depth;
uniform float u_pseudo_25d_shell_support;
uniform float u_pseudo_25d_enclosure;
// Burn Front v2: no temperature-floor teleport, per-particle ignition jitter,
// faster burn-through, quenchable flames.
uniform int   u_burn_front_v2;
uniform float u_burn_rate_scale;
uniform float u_burn_ignition_jitter;
// Living Regrowth v2: when on, the g2p neighbor-aware regrowth path is the
// SOLE owner of regrow(damage)/ash(phase_data). This p2g branch still runs
// its mechanical model (stress, impact crumble) but defers its
// temperature-only regrow/ash state writes so the two state machines stop
// fighting. Crumble (impact fracture) stays owned here.
uniform int   u_living_v2;
// Stiffness Fix v2: global E multiplier (the material catalog is 1.1-42 kPa,
// far too soft to resist rho*g*H at g=10), a compression barrier so restoring
// stress keeps growing past the F singular-value clamp instead of saturating
// (the "collapse into a line" failure), and floors on the ortho materials'
// cross-fiber stiffness (the unfloored cross stiffness is below the weight of
// a single grid cell).
uniform int   u_stiffness_v2;
uniform float u_stiffness_scale;
uniform float u_compression_stiffness;
// Stiffness v3 "World Scale": the E catalog is 1-2 orders too soft for the
// 6.4m world (a 1m column needs ~10 kPa; lambda support is capped at
// 0.25*lambda). v3 multiplies E per family and raises the solid SVD floor so the
// compression barrier takes over before silent volume loss.
uniform int   u_stiffness_v3;
uniform float u_v3_solid_mult; // structural solids E multiplier (~12x)
uniform float u_v3_soft_mult;  // puffy/soft-body family multiplier (~2x)
// Bake Stability v2: tear/crack drives for the gas-inflating dough materials
// measure tension against the INFLATED rest stretch sqrt(J_rest) instead of
// sigma=1, and intended inflation no longer counts directly as damage; the
// legacy measure makes a fully risen loaf self-tear at rest.
uniform int   u_bake_v2;
uniform int   u_porous_growth_v3; // optional stress-free isotropic growth; default 0
uniform int   u_bake_profiles; // Bake Profile v1; 0 = off
// Aniso Fracture v1. 0 = Legacy hand-tuned, 1 = AnisoMPM isotropic (alpha forced 0),
// 2 = AnisoMPM anisotropic (alpha from LUT).
uniform int   u_fracture_model;
uniform int   u_frac_history;      // 1 = keep the monotone D_tilde history (anti crack-stall)
uniform float u_frac_eta_scale;    // crack viscosity multiplier
uniform float u_frac_tough_scale;  // toughness multiplier
uniform float u_frac_l0_scale;     // crack width l0 multiplier
uniform float u_pseudo_25d_cohesion;
uniform vec2  u_magnet_pos;
uniform float u_magnet_radius;
uniform float u_magnet_falloff_radius;
uniform float u_magnet_force;
uniform float u_magnet_spike_strength;
uniform float u_magnet_chain_rate;
uniform float u_magnet_spike_freq;
uniform int   u_use_real_magnetics;
uniform int   u_mag_apply_surface_force;
uniform float u_mag_assist_spike_strength;
uniform float u_mag_assist_corrugation_strength;
uniform int   u_use_sdf;
uniform float u_bio_regrowth_rate;
uniform vec2  u_sdf_world_min;
uniform vec2  u_sdf_world_max;
uniform vec2  u_magnetic_world_min;
uniform vec2  u_magnetic_world_max;

