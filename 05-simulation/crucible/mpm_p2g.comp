vec4 resolve_thermal_coupling(uint mat_type, uint local_idx) {
    vec4 authored = texelFetch(u_thermal_coupling_tex, int(local_idx));
    if (dot(abs(authored), vec4(1.0)) > 1e-6) return authored;
    return thermal_coupling_defaults(mat_type);
}

// Bake Profile v1: fetch the 3 profile texels for a material id from the static LUT.
//   a = (set_temp, rise_shrink_scale, cure_rate, crust_brittleness)
//   b = (rise_sign, set_width, E_stiffen_lo, E_stiffen_hi)
//   c = (base_E, base_nu, base_fiber, reserved)  [c is consumed CPU-side at spawn]
// Only called from a wrapped bake branch under the u_bake_profiles guard; unwrapped
// (unauthored) materials never call it, so an all-zero row is never read.
void resolve_bake_profile(uint mat_type, out vec4 a, out vec4 b, out vec4 c) {
    int base = int(mat_type) * 3;
    a = texelFetch(u_bake_profile_tex, base + 0);
    b = texelFetch(u_bake_profile_tex, base + 1);
    c = texelFetch(u_bake_profile_tex, base + 2);
}

// ---- Aniso Fracture v1 -------------------------------------------------------
// AnisoMPM explicit anisotropic continuum damage (Wolper et al. 2020). Only ever
// called under the u_fracture_model guard, so an unbound/all-zero LUT can never
// reach the legacy path.
//   a = (percent, eta, zeta, alpha)   b = (l0_ratio, k_residual, D_max, flags)
void resolve_fracture_profile(uint mat_type, out vec4 a, out vec4 b) {
    int base = int(mat_type) * 2;
    a = texelFetch(u_fracture_profile_tex, base + 0);
    b = texelFetch(u_fracture_profile_tex, base + 1);
}

// outer2 (defined with the orthotropic-stiffness helpers above) is used here only for self-outer
// products n (x) n, which are symmetric.
// Spectral positive part of a symmetric 2x2 -- closed form, no iterative solver.
// Eigenvector identity: (S - e1*I)*(b, e1-a) = 0 exactly, since (a-e1)(c-e1) = b^2.
mat2 spectral_positive2(mat2 S) {
    float a = S[0][0], b = S[0][1], c = S[1][1];
    float m = 0.5 * (a + c), q = 0.5 * (a - c);
    float rad = sqrt(max(q*q + b*b, 0.0));
    float e1 = m + rad, e2 = m - rad;
    vec2 n1 = (rad > 1e-9 && abs(b) > 1e-9) ? normalize(vec2(b, e1 - a))
                                            : ((a >= c) ? vec2(1.0, 0.0) : vec2(0.0, 1.0));
    vec2 n2 = vec2(-n1.y, n1.x);
    return max(e1, 0.0) * outer2(n1, n1) + max(e2, 0.0) * outer2(n2, n2);
}

// One explicit AnisoMPM damage step. Returns the degradation factor g(d) and writes
// the updated d back through `d_io`. `stress_undeg` must be the UNDEGRADED Kirchhoff
// stress (the driving force has to see it before degradation -- ziran2020
// evaluateEffectiveCauchyStress).
// NOTE: takes the MPM-LOCAL index (frac_aux_buf_ is mpm_cap-sized, like damage/Jp).
float aniso_damage_step(uint lidx, mat2 stress_undeg, float J, mat2 R, vec2 fiber0,
                        float mu_eff, float lam_eff, vec4 fpA, vec4 fpB,
                        inout float d_io) {
    // Symmetrized Cauchy stress
    mat2 S = (0.5 / max(J, 1e-4)) * (stress_undeg + transpose(stress_undeg));
    mat2 sp = spectral_positive2(S);

    // Structural tensor. Use the POLAR rotation (not the F-pushforward, which would
    // contaminate the direction with stretch). alpha 0 => A = I (isotropic);
    // alpha -1 => A = I - a^a = the cross-fiber projector, so along-fiber tension
    // contributes nothing and cracks run ALONG the grain.
    float alpha = (u_fracture_model == 1) ? 0.0 : fpA.w; // mode 1 = the paper's isotropic control
    mat2 A = mat2(1.0);
    // Gate on the SAME fiber-length test the fiber stress term uses (> 0.3). A looser
    // gate would let a residual near-zero fiber that contributes no stress still be
    // normalize()d into a full cross-fiber projector, letting numerical noise steer
    // crack direction. If there is no usable fiber the structural tensor really is the
    // identity, so alpha is zeroed too and sigma_c below normalizes as isotropic.
    if (alpha != 0.0 && length(fiber0) > 0.3) {
        vec2 ah = normalize(R * fiber0);
        A += alpha * outer2(ah, ah);
    } else {
        alpha = 0.0;
    }

    // Critical stress from the authored "breaks at N% stretch", evaluated in-shader
    // from the live mu_eff/lam_eff so it tracks stiffness_scale / v3 / thermal softening.
    float percent = max(fpA.x, 1e-4) * max(u_frac_tough_scale, 1e-3);
    float s = 1.0 + percent;
    float sigma_1 = 2.0 * mu_eff * percent / s + lam_eff * (s * s - 1.0);
    // Alpha-normalized so `percent` means the same thing at every alpha: switching
    // mode 1 -> 2 changes DIRECTIONALITY only, not overall toughness.
    //
    // The normalizer is derived for the load case sigma_1 is built from -- a UNIAXIAL
    // stretch. For a rank-1 positive stress sp = s*(n(x)n) with c = dot(ahat, n):
    //     A sp : sp A = s^2 * (1 + alpha*c^2)^2
    // so the worst-case direction gives sqrt(A sp : sp A) = s * max(1, 1 + alpha).
    // Note that sqrt((1+alpha)^2 + 1) = sqrt(A:A) is the HYDROSTATIC normalizer,
    // correct only for sp = s*I. Pairing it with a uniaxial sigma_1 would make the
    // isotropic case need sqrt(2)x more stress than authored while the alpha = -1
    // case needs exactly 1x, so mode 1 -> 2 would change TOUGHNESS as well as
    // directionality and mode 1 would no longer be the paper's controlled isotropic
    // reference at matched toughness.
    float sigma_c = max(abs(sigma_1) * max(1.0, 1.0 + alpha), 1e-4);

    // Driving force Phi = (A s+):(s+ A) / sigma_c^2, with the AT1-style elastic
    // threshold <Phi - 1>: below it no damage accrues at all.
    mat2 M1 = A * sp;
    mat2 M2 = sp * A;
    float phi = dot(vec4(M1[0], M1[1]), vec4(M2[0], M2[1])) / (sigma_c * sigma_c);

    vec4 aux = imageLoad(u_frac_aux, int(lidx));
    float zeta = max(fpA.z, 0.0);
    float D_max = max(fpB.z, 0.0);
    float D_tilde = zeta * max(phi - 1.0, 0.0);
    if (u_frac_history == 1) D_tilde = max(aux.x, D_tilde); // monotone: anti crack-stall
    D_tilde = min(D_tilde, D_max);
    aux.x = D_tilde;
    imageStore(u_frac_aux, int(lidx), aux);

    // eta*d_dot = <(1-d)*D_tilde - (d - l0^2*Lap(d))>, explicit forward Euler with a
    // fixed-point step clamp for stability.
    float d = clamp(d_io, 0.0, 1.0);
    float l0 = max(fpB.x, 0.0) * max(u_frac_l0_scale, 0.0) * u_dx;
    float lap_d = aux.y;
    float eta = max(fpA.y, 1e-4) * max(u_frac_eta_scale, 1e-3);
    float rate = min(u_dt / eta, 0.999 / (D_tilde + 1.0 + 4.0 * l0 * l0 / max(u_dx * u_dx, 1e-12)));
    float drive = max((1.0 - d) * D_tilde - (d - l0 * l0 * lap_d), 0.0);
    d = min(1.0, d + rate * drive);
    d_io = d;

    float k = clamp(fpB.y, 0.0, 0.5);
    return (1.0 - d) * (1.0 - d) * (1.0 - k) + k; // g(d)
}

// F = Fe * Fg, with isotropic 2D growth Fg = sqrt(J_rest) I.
// Evaluate BOTH corotated terms on Fe. Shifting only the volumetric term
// leaves a spurious shear restoring stress even at F = Fg (free expansion).
mat2 porous_growth_stress(mat2 F, mat2 R, float J, float J_rest, float mu, float lambda) {
    float rest = max(J_rest, 0.25);
    mat2 Fe = F / sqrt(rest);
    float Je = J / rest;
    return 2.0 * mu * (Fe - R) * transpose(Fe)
         + lambda * (Je - 1.0) * Je * mat2(1.0);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u_count) return;

    uint p = u_offset + idx;
    vec2 pos  = positions[p];
    vec2 vel  = velocities[p];
    float mass = masses[p];
    // Real 2.5D: material id lives in bits 0..6; z-occupancy (0..1) in bits 8..15,
    // with byte 0 = full occupancy (sentinel) so un-carved particles read as solid
    // and the mask is a no-op for them. Masking the id is forward-safe (ids < 128).
    uint raw = material_ids[p];
    uint mat_type = raw & 0x7Fu;
    float z_occ = 1.0;
    if (u_real_25d == 1) {
        uint zb = (raw >> 8) & 0xFFu;
        z_occ = (zb == 0u) ? 1.0 : float(zb) * (1.0 / 255.0);
    }
    float temp = temperatures[p];

    // Bake Profile v1: resolve this material's profile once (under the guard) so the
    // bake branches can spread their set-temp / rise / cure / crust / oven-spring
    // literals. bpA=(set_temp, rise_shrink_scale, cure_rate, crust_brittleness);
    // bpB=(rise_sign, set_width, E_stiffen_lo, E_stiffen_hi). Off => use_bp false and
    // every wrapped literal takes its legacy value.
    bool use_bp = (u_bake_profiles == 1);
    vec4 bpA = vec4(0.0), bpB = vec4(0.0), bpC = vec4(0.0);
    if (use_bp) resolve_bake_profile(mat_type, bpA, bpB, bpC);

    // Aniso Fracture v1: resolve the fracture profile once. fp_allow is the per-material
    // enrollment bit -- an unenrolled material keeps its legacy branch even in mode 2,
    // which is what lets the model roll out material-by-material as data edits.
    bool use_frac = (u_fracture_model >= 1);
    vec4 fpA = vec4(0.0), fpB = vec4(0.0);
    bool fp_allow = false;
    if (use_frac) {
        resolve_fracture_profile(mat_type, fpA, fpB);
        fp_allow = (uint(fpB.w + 0.5) & 1u) != 0u;
    }
    // Carried out of the constitutive dispatch so the stress ceiling below can be
    // degraded too (otherwise the damage multiply is arithmetically invisible under
    // load). 1.0 for every unenrolled material and the whole off path.
    float g_applied = 1.0;

    // Hard velocity clamp — 3 cells/step max (very conservative)
    float spd = length(vel);
    float max_v = u_dx * 3.0 / u_dt;
    if (spd > max_v || spd != spd) {
        vel = (spd != spd) ? vec2(0.0) : vel * (max_v / spd);
    }

    float inv_dx = 1.0 / u_dx;

    vec2 cell_pos = (pos - u_grid_origin) * inv_dx;
    ivec2 base = ivec2(floor(cell_pos - 0.5));
    vec2 fx = cell_pos - vec2(base);
    vec3 wx = bspline_weights(fx.x);
    vec3 wy = bspline_weights(fx.y);

    // --- Update deformation gradient ---
    mat2 F = vec4_to_mat2(deform_grads[idx]);
    mat2 C = vec4_to_mat2(affine_moms[idx]);
    F = (mat2(1.0) + u_dt * C) * F;

    SVD2 svd = svd2x2(F);
    // Tighter clamp for solid materials (prevent excessive compression)
    bool is_solid_mat = (mat_type == MAT_ELASTIC || mat_type == MAT_ANISO ||
                         mat_type == MAT_FRACTURE || mat_type == MAT_HARDEN ||
                         mat_type == MAT_CERAMIC || mat_type == MAT_COMPOSITE ||
                         mat_type == MAT_BRITTLE || mat_type == MAT_TOUGH ||
                         mat_type == MAT_GLASS || mat_type == MAT_BLOOM ||
                         mat_type == MAT_FOAM || mat_type == MAT_SPLINTER ||
                         mat_type == MAT_BREAD || mat_type == MAT_PUFF_CLAY ||
                         mat_type == MAT_FIRECRACKER || mat_type == MAT_GLAZE_CLAY ||
                         mat_type == MAT_CRUST_DOUGH || mat_type == MAT_THERMO_METAL ||
                         mat_type == MAT_REACTIVE_BURN || mat_type == MAT_GLAZE_DRIP ||
                         mat_type == MAT_STEAM_BUN || mat_type == MAT_FILAMENT_GLASS ||
                         mat_type == MAT_CHEESE_PULL || mat_type == MAT_MEMORY_WAX ||
                         mat_type == MAT_MAILLARD || mat_type == MAT_MUSHROOM ||
                         mat_type == MAT_CRUMB_LOAF || mat_type == MAT_BISQUE ||
                         mat_type == MAT_TEAR_SKIN || mat_type == MAT_LAMINATED_PASTRY ||
                         mat_type == MAT_STONEWARE || mat_type == MAT_ORTHO_BEND ||
                         mat_type == MAT_ORTHO_TEAR || mat_type == MAT_VENT_CRUMB ||
                         mat_type == MAT_VITREOUS_CLAY || mat_type == MAT_BLISTER_GLAZE ||
                         mat_type == MAT_OPEN_CRUMB || mat_type == MAT_SINTER_LOCK ||
                         mat_type == MAT_BINDER_CRUMB || mat_type == MAT_CHANNEL_CRUMB ||
                         mat_type == MAT_BURNOUT_CLAY || mat_type == MAT_VENTED_SKIN ||
                         mat_type == MAT_TOPO_GOO || mat_type == MAT_OOBLECK ||
                         mat_type == MAT_IMPACT_GEL || mat_type == MAT_SEALED_CHARGE ||
                         mat_type == MAT_MORPH_TISSUE || mat_type == MAT_ROOT_WEAVE ||
                         mat_type == MAT_CELL_SHEET || mat_type == MAT_ASH_REGROWTH ||
                         mat_type == MAT_ASH_COLONY ||
                         mat_type == MAT_INFESTATION_VEIN || mat_type == MAT_SURFACE_CREEPER ||
                         mat_type == MAT_ANCHORED_SURFACE_CREEPER ||
                         mat_type == MAT_SUPERCONDUCTOR || mat_type == MAT_CURIE_FERRO ||
                         mat_type == MAT_EDDY_COPPER || mat_type == MAT_HARD_MAGNET ||
                         mat_type == MAT_SAND_GRANULAR || mat_type == MAT_PHASE_BRITTLE ||
                         mat_type == MAT_TRIBOELECTRIC);
    // Soft/puffy family (same list as the E*1.8 stress-ceiling branch below):
    // under Stiffness v3 these keep a gentle multiplier so risen dough, gels and
    // living tissue stay squishy while structural solids get world-scale E.
    bool is_soft_body_mat = (mat_type == MAT_FOAM || mat_type == MAT_BREAD ||
                             mat_type == MAT_PUFF_CLAY || mat_type == MAT_CRUST_DOUGH ||
                             mat_type == MAT_STEAM_BUN || mat_type == MAT_CRUMB_LOAF ||
                             mat_type == MAT_OPEN_CRUMB || mat_type == MAT_BINDER_CRUMB ||
                             mat_type == MAT_CHANNEL_CRUMB || mat_type == MAT_VENT_CRUMB ||
                             mat_type == MAT_MORPH_TISSUE || mat_type == MAT_ROOT_WEAVE ||
                             mat_type == MAT_CELL_SHEET || mat_type == MAT_ASH_REGROWTH ||
                             mat_type == MAT_ASH_COLONY ||
                             mat_type == MAT_INFESTATION_VEIN || mat_type == MAT_SURFACE_CREEPER ||
                             mat_type == MAT_ANCHORED_SURFACE_CREEPER ||
                             mat_type == MAT_TOPO_GOO || mat_type == MAT_IMPACT_GEL);
    // v3 raises the solid compression floor 0.5 -> 0.85 so the SVD clamp is a rare
    // safety guard, not the resting state; the barrier (J_floor = sig_min^2)
    // activates earlier and support grows continuously instead of freezing a
    // shrunken F with silent volume loss.
    float sig_min = is_solid_mat ? ((u_stiffness_v3 == 1) ? 0.85 : 0.5) : 0.1;
    float sig_max = is_solid_mat ? 3.0 : 8.0;
    // Raw (pre-clamp) volume ratio: feeds the Stiffness-v2 compression
    // barrier below, so resistance keeps growing past the clamp instead of
    // saturating while gravity keeps loading.
    float J_raw = svd.sigma.x * svd.sigma.y;
    svd.sigma = clamp(svd.sigma, vec2(sig_min), vec2(sig_max));
    F = svd.U * mat2(svd.sigma.x, 0, 0, svd.sigma.y) * transpose(svd.V);
    float J = svd.sigma.x * svd.sigma.y;

    // --- Material parameters ---
    vec4 base_params = mat_params0[idx];
    float E = (base_params.x > 0.0) ? base_params.x : u_E;
    if (u_stiffness_v2 == 1) {
        E *= max(u_stiffness_scale, 0.01);
    }
    // Stiffness v3: per-family world-scale multiplier. Structural solids get the
    // full boost (lambda must exceed rho*g*H ~ 10-20 kPa in this 6.4m world);
    // the soft/puffy family stays gentle; fluids and the living-culture family
    // (not in either list) are untouched.
    if (u_stiffness_v3 == 1) {
        if (is_soft_body_mat)   E *= max(u_v3_soft_mult, 0.1);
        else if (is_solid_mat)  E *= max(u_v3_solid_mult, 0.1);
    }
    float nu = (base_params.x > 0.0) ? base_params.y : u_nu;
    float fiber_strength = (base_params.x > 0.0) ? base_params.z : u_fiber_strength;
    float shell_seed = clamp(base_params.w, 0.0, 1.0);
    float core_seed = 1.0 - shell_seed;
    float pseudo_depth = (u_enable_pseudo_25d != 0) ? clamp(u_pseudo_25d_depth, 0.0, 2.0) : 0.0;
    float pseudo_shell = (u_enable_pseudo_25d != 0) ? clamp(u_pseudo_25d_shell_support, 0.0, 2.0) : 0.0;
    float pseudo_enclosure = (u_enable_pseudo_25d != 0) ? clamp(u_pseudo_25d_enclosure, 0.0, 2.0) : 0.0;
    float pseudo_cohesion = (u_enable_pseudo_25d != 0) ? clamp(u_pseudo_25d_cohesion, 0.0, 2.0) : 0.0;
    float pseudo_shell_boost = 1.0 + pseudo_shell * (0.18 + 0.82 * shell_seed);
    float pseudo_volume_hold = 1.0 + pseudo_depth * (0.16 + 0.84 * core_seed);
    float pseudo_enclosure_hold = 1.0 + pseudo_enclosure * (0.14 + 0.86 * core_seed);
    float pseudo_split_hold = 1.0 + pseudo_cohesion * (0.16 + 0.84 * core_seed);
    float fracture_threshold = u_fracture_threshold;
    float fracture_rate = u_fracture_rate;
    vec4 thermal_params = resolve_thermal_coupling(mat_type, idx);

    // Temperature softening for thermal/phase materials
    if (mat_type == MAT_THERMAL) {
        E *= clamp(1.0 - (temp - 300.0) / 200.0, 0.05, 1.0);
    }

    float mu     = E / (2.0 * (1.0 + nu));
    float lambda = E * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));

    // --- Constitutive model ---
    mat2 stress;
    mat2 R = svd.U * transpose(svd.V);

    if (mat_type == MAT_FLUID ||
        mat_type == MAT_POSITIVE_ION || mat_type == MAT_NEGATIVE_ION) {
        // Ions: light fluid constitutive (same as MAT_FLUID). Their
        // distinguishing behavior is the Coulomb force applied in g2p;
        // the EOS just keeps them behaving like a mobile compressible
        // gas/liquid so the field can shape them.
        F = mat2(sqrt(max(J, 0.01)));
        J = max(J, 0.01);
        stress = mat2(lambda * J * (J - 1.0));
    }
    else if (mat_type == MAT_ROPE_SEGMENT) {
        // Rope particle: zero MPM stress. XPBD distance constraints
        // handle all structural forces after the MPM step. Gravity,
        // drag, and magnetic forces still apply via G2P velocity
        // updates — the constraint pass corrects positions to preserve
        // segment lengths.
        F = mat2(1.0);
        J = 1.0;
        stress = mat2(0.0);
    }
    else if (mat_type == MAT_FLAMMABLE_FLUID) {
        float burn = damage[idx];
        float batch_heat = max(thermal_params.y, 0.1);
        float batch_cooling = max(thermal_params.z, 0.02);
        float oxy_air = sample_oxygen(pos);
        float oxy_gate = smoothstep(0.06, 0.45, oxy_air);
        if (u_fire_smolder == 1) oxy_gate *= mix(1.0, 0.4, 1.0 - smoothstep(u_smolder_o2_lo * 0.5, u_smolder_o2_lo, oxy_air));
        if (temp > 338.0 && burn < 1.0) {
            float fuel_hold = mix(0.60, 0.96, clamp(batch_cooling, 0.0, 1.2));
            float ignition = clamp((temp - 330.0) / 210.0, 0.0, 1.0);
            float burn_drag = mix(1.0, 0.62, smoothstep(0.18, 0.80, burn));
            burn += 0.82 * fuel_hold * burn_drag * ignition * oxy_gate * u_dt;
        }
        if (burn > 0.02 && burn < 0.98) {
            float flame = clamp(burn * (1.0 - burn) * 4.0, 0.0, 1.0);
            temp += (620.0 + 170.0 * batch_heat) * flame * oxy_gate * u_dt;
            // Relight floor fades out as oxygen is depleted, so a suffocated
            // pool can actually cool instead of holding at the floor.
            float floor_t = 465.0 + 65.0 * min(batch_heat, 1.5) + 30.0 * flame;
            temp = max(temp, mix(temp, floor_t, oxy_gate));
        }
        if (burn > 0.92) {
            temp += (345.0 - temp) * mix(0.036, 0.012, clamp(batch_cooling, 0.0, 1.0)) * u_dt;
        }
        burn = clamp(burn, 0.0, 1.0);
        damage[idx] = burn;
        temperatures[p] = clamp(temp, 0.0, 1400.0);

        float vapor = smoothstep(0.72, 0.99, burn);
        float bulk = max(E * mix(0.28, 0.10, vapor), 450.0);
        float J_rest = 1.0 + vapor * 0.08 + burn * 0.018;
        F = mat2(sqrt(max(J, 0.01)));
        J = max(J, 0.01);
        stress = mat2(bulk * J * (J - J_rest));
        C *= (1.0 - vapor * 0.16);
    }
    else if (mat_type == MAT_FERRO_FLUID || mat_type == MAT_HEAVY_FERRO_FLUID ||
             mat_type == MAT_DIAMAGNETIC_FLUID || mat_type == MAT_PARA_MIST ||
             mat_type == MAT_STICKY_FERRO || mat_type == MAT_PERMANENT_FERRO) {
        // Heavy variant reuses the Tait EOS + spike dynamics — it's the same
        // fluid, just with much stronger magnetic response (tuned in the
        // magnetic force block in mpm_g2p and Langevin saturation in
        // magnetic_particles). That way all the surface-tension / spike code
        // still applies and spikes can form.
        // ── Weakly compressible Tait EOS ──────────────────────────────
        // p = B * ((rho/rho0)^gamma - 1),  B = rho0 * c0^2 / gamma
        //
        // CFL BUDGET (dx ≈ 0.033, sub_dt ≈ 1.67e-3, 5 substeps at 1/120):
        //   Tait:     c0 <= 0.4 * dx / sub_dt ≈ 8.0 m/s
        //   Viscous:  mu <= 0.5 * dx² * rho / sub_dt ≈ 440 Pa·s
        //
        // These limits are hard: exceed them and the integrator
        // oscillates, overshoots, and the fluid explodes.

        // Thermal softening: placeholder for future Curie-law chi
        // modulation. For now only softens bulk and viscosity a little.
        float hot = smoothstep(360.0, 700.0, temp);

        // EOS constants. c0 set conservatively (~75% of CFL limit)
        // because real-world deformation rates can locally amplify the
        // effective wave speed when combined with affine momentum.
        const float c0_cold   = 6.0;
        const float c0_warm   = 4.5;
        const float gamma_eos = 7.0;

        // Derive rho0 from the actually spawned particle mass instead of
        // assuming one hard-coded fluid density. Scenes that use a lighter
        // density_scale would otherwise be treated as rho0=1350 and the
        // puddle would behave like a hidden "ferro pebble" material.
        float rho0 = clamp(mass / max(u_p_vol, 1e-6), 120.0, 1800.0);
        float density_ratio = clamp(rho0 / 1000.0, 0.12, 1.8);

        float c0    = mix(c0_cold, c0_warm, hot);
        float B_mod = rho0 * c0 * c0 / gamma_eos;  // ~6943 Pa cold

        // J safety clamp: lower bound prevents Tait runaway under
        // compression (pressure ~ (1/J)^7 goes vertical near J=0).
        // Upper bound is just a numerical safety net — Tait tension
        // naturally plateaus at -B_mod as J → ∞, so there's no
        // runaway on that side.
        //
        // Per-material lower bound: real ferrofluid is essentially
        // incompressible at fluid timescales. Without a tight clamp,
        // strong Kelvin attraction can compress particles to J ~ 0.7
        // (30% packed), a visible "collapse to dots", even though the
        // Tait EOS is stiff. 0.85 gives max 15% compression — a visible
        // cluster but not pathological.
        // Heavy ferro tighter still since its pull is stronger.
        float j_floor = 0.7;
        if (mat_type == MAT_HEAVY_FERRO_FLUID || mat_type == MAT_PERMANENT_FERRO) j_floor = 0.90;
        else if (mat_type == MAT_FERRO_FLUID || mat_type == MAT_STICKY_FERRO ||
                 mat_type == MAT_DIAMAGNETIC_FLUID) j_floor = 0.85;
        else if (mat_type == MAT_PARA_MIST) j_floor = 0.75; // lighter, can compress a bit more
        float J_safe  = clamp(J, j_floor, 4.0);
        float rho_rel = 1.0 / J_safe;

        // Full Tait: positive pressure (compression) pushes outward,
        // NEGATIVE pressure (rarefaction) pulls inward. The tensile
        // branch is the restoring force that keeps the fluid cohesive
        // at rest density. Clamping this to max(p, 0) would remove the
        // only mechanism that can bring expanded particles back
        // together — without tension the fluid puffs up indefinitely
        // because nothing resists rarefaction.
        //
        // Tait tension saturates at ~-B_mod ≈ -7kPa, well inside the
        // fluid stress clamp (E*40 ≈ 168kPa), and the cold c0=6 keeps
        // the wave speed inside CFL — so explicit-integrator blow-up
        // from tension is not a concern at these parameters.
        float p       = B_mod * (pow(rho_rel, gamma_eos) - 1.0);
        float occ_support_p = sample_magnetic_occupancy_smooth(pos);
        vec2 occ_grad_p = magnetic_occ_grad(pos);
        float occ_grad_mag_p = length(occ_grad_p);

        // Pseudo-2.5D thickness for ferro: the 2D slice has no hidden depth,
        // so a one-cell "air tunnel" numerically splits the liquid. Use the
        // existing magnetic occupancy as a cheap thickness proxy: packed cells
        // gain extra pressure, while connected free surfaces get a mild bridge
        // tension. This is deliberately weaker than EOS pressure so it helps
        // columns/spikes stay continuous without turning into cursor glue.
        if (u_enable_pseudo_25d != 0) {
            float ferro_depth = clamp(pseudo_depth, 0.0, 2.0);
            float ferro_cohesion = clamp(pseudo_cohesion, 0.0, 2.0);
            float ferro_enclosure = clamp(pseudo_enclosure, 0.0, 2.0);
            float connected_p = smoothstep(0.24, 1.10, occ_support_p);
            float interface_p = smoothstep(0.035, 0.20, occ_grad_mag_p);
            float target_occ = (mat_type == MAT_HEAVY_FERRO_FLUID || mat_type == MAT_PERMANENT_FERRO)
                             ? mix(5.4, 6.8, ferro_depth * 0.5)
                             : mix(4.8, 6.2, ferro_depth * 0.5);
            float thick_excess = max(occ_support_p - target_occ, 0.0);
            float thick_pack = 1.0 - exp(-0.22 * thick_excess);
            float thin_sheet = connected_p * interface_p *
                               (1.0 - smoothstep(2.0, target_occ, occ_support_p));
            p += B_mod * (0.10 + 0.20 * ferro_depth + 0.08 * ferro_enclosure) * thick_pack;
            p -= B_mod * (0.025 + 0.060 * ferro_cohesion) * thin_sheet;
            p = max(p, -B_mod * (1.04 + 0.10 * ferro_cohesion));
        }

        // Demag pressure: magnetized regions have ~½μ₀M² internal energy
        // density that opposes further compaction. THRESHOLD-GATED: only
        // fires once |H|² is well above what the cursor magnet produces
        // at typical reach. Without this gate, demag pressure would
        // resist the initial Kelvin pull (because it has the opposite
        // sign — pressure gradient pushes from high-|H| to low-|H|), so
        // ferro would respond weakly to the cursor. With the gate, ferro
        // flows freely toward the cursor (low/moderate |H|), but once a
        // cluster forms and |H|² climbs into the cluster regime, demag
        // pressure kicks in hard to stop further packing.
        if (u_use_real_magnetics != 0) {
            vec4 drive_smooth = sample_magnetic_drive_field_smooth(pos);
            vec4 total_smooth = sample_magnetic_total_field_smooth(pos);
            float self_h2 = max(total_smooth.w - drive_smooth.w, 0.0);
            // Demag pressure should oppose particle self-packing, not the
            // external field that is trying to lift the blob. Use only the
            // excess total-field energy from the fluid's own magnetization.
            float cluster_gate = smoothstep(24.0, 140.0, self_h2);
            const float k_demag_p = 14.0;
            p += k_demag_p * self_h2 * cluster_gate;

            // Occupancy pressure: J is per-particle history, so a strong
            // magnetic point sink can still pile many particles into one
            // magnetic cell without every particle seeing a sufficiently
            // small J. Only apply this as an anti-collapse cue when the
            // field is self-amplifying or the cell is severely overpacked;
            // firing it for every moderately dense connected blob creates
            // the hollow-waist/two-pole failure mode.
            float crowd = max(occ_support_p - 5.2, 0.0);
            float crowd_gate = smoothstep(5.2, 10.0, occ_support_p);
            float moderate_crowd_gate = smoothstep(6.2, 10.8, occ_support_p);
            float severe_crowd_gate = smoothstep(8.6, 13.0, occ_support_p);
            float anti_collapse_gate = max(cluster_gate, severe_crowd_gate);
            float crowd_sat = 1.0 - exp(-0.32 * crowd);
            p += B_mod * 0.55 * crowd_sat * crowd_gate * anti_collapse_gate;
            p += B_mod * 0.32 * crowd_sat * moderate_crowd_gate;

            // Do not add an external negative-pressure well here. Translating
            // ferrofluid toward the source is handled by the Kelvin body force
            // in G2P, while visible Rosensweig structure is handled by the
            // interface Maxwell/surface terms below. A pressure suction with a
            // world-up bias can hollow the blob into a top-half pump/atom-shell
            // pattern instead of a symmetric pole response.
        }

        // Fluid: no shear memory. Reset F to isotropic scaling of J.
        F = mat2(sqrt(J_safe));
        J = J_safe;

        // Viscous damping stress from APIC C. 120 Pa·s cold is ~1.3
        // orders of magnitude more viscous than water — appropriate
        // for ferrofluid, and well inside the 440 Pa·s CFL limit.
        float mu_visc = mix(120.0, 50.0, hot) *
                        mix(0.55, 1.0, smoothstep(0.18, 1.0, density_ratio));

        // Hydrostatic pressure + viscous deviator.
        stress = mat2(-p) + mu_visc * (C + transpose(C));

        if (u_use_real_magnetics != 0 && u_mag_apply_surface_force != 0) {
            vec4 drive_local = sample_magnetic_drive_field_smooth(pos);
            vec4 total_local = sample_magnetic_total_field_smooth(pos);
            vec4 drive_bulk = vec4(0.0);
            vec2 grad_h2 = vec2(0.0);
            float grad_mag = 0.0;
            float rigid_gate = magnetic_drive_response_gate(pos, drive_bulk, grad_h2, grad_mag);
            float wall_gate = magnetic_wall_gate(pos, 0.16);
            vec2 drive_vec = mix(drive_local.xy, drive_bulk.xy, 0.68);
            float induced_gain = clamp((total_local.z - drive_local.z) / max(drive_local.z, 1e-4), 0.0, 1.0);
            vec2 align_vec = mix(drive_vec, total_local.xy, 0.16 * induced_gain);
            float hmag = mix(drive_local.z, drive_bulk.z, 0.72);
            if (hmag > 1e-4) {
                vec2 field_dir = normalize(align_vec + vec2(1e-6, 0.0));
                vec2 field_tangent = vec2(-field_dir.y, field_dir.x);

                // Anisotropic magnetic stress, rather than Kelvin attraction
                // alone: a coarse 2D Maxwell-stress approximation that creates
                // field-aligned chain tension and lateral squeeze so puddles
                // can neck into combs/spikes instead of translating as a blob.
                float sat = 1.0 - exp(-hmag * 0.42);
                float grad_term = grad_mag / (hmag * hmag + 1e-4);
                float mag_gate = rigid_gate * wall_gate;
                float occ_support = sample_magnetic_occupancy_smooth(pos);
                float pack_gate = smoothstep(0.16, 0.50, occ_support);
                float occ = sample_magnetic_occupancy(pos);
                vec2 occ_grad = magnetic_occ_grad(pos);
                float occ_grad_mag = length(occ_grad);
                float interface_band = smoothstep(0.06, 0.28, occ_grad_mag) *
                                       smoothstep(0.05, 0.22, occ) *
                                       pack_gate;
                float crowd_gate = smoothstep(4.8, 8.5, occ_support);
                float chain_boost = (mat_type == MAT_HEAVY_FERRO_FLUID) ? 1.18
                                  : (mat_type == MAT_PERMANENT_FERRO ? 1.10 : 1.0);
                float spike_boost = (mat_type == MAT_HEAVY_FERRO_FLUID) ? 1.88
                                  : (mat_type == MAT_PERMANENT_FERRO ? 1.52 : 1.0);
                float chain = clamp(0.11 * u_magnet_chain_rate * sat * mag_gate * chain_boost, 0.0, 2.5);
                float assist_spike = max(u_mag_assist_spike_strength, 0.0);
                float spike = clamp(0.16 * u_magnet_spike_strength *
                                    (0.35 * sat + 0.65 * clamp(grad_term, 0.0, 2.5)) *
                                    spike_boost * (1.0 + 0.42 * assist_spike),
                                    0.0, 4.1 + 2.4 * assist_spike) * mag_gate * mag_gate;
                chain *= mix(0.45, 1.0, pack_gate);
                spike *= pack_gate;

                // Keep body stress extremely small. Strong volume Maxwell
                // stress makes the whole blob draw field-contour/layer bands;
                // visible Rosensweig structure should mainly come from the
                // free surface while translation comes from G2P Kelvin force.
                float body_band = 0.06 * interface_band;
                float crowd_release = mix(1.0, 0.42, crowd_gate);
                float magnetic_scale = B_mod * (0.010 * chain + 0.024 * spike) *
                                       body_band * crowd_release;
                mat2 maxwell = -magnetic_scale *
                    (outer2(field_dir, field_dir) - 0.50 * mat2(1.0));
                stress += maxwell;

                // Field-aligned extensional viscosity: once columns start
                // forming, this helps them stay coherent instead of turning
                // into free-flying dust under the bulk magnetic pull.
                mat2 D = 0.5 * (C + transpose(C));
                float along_rate = dot(field_dir, D * field_dir);
                float across_rate = dot(field_tangent, D * field_tangent);
                float chain_visc = mu_visc * (0.18 * chain + 0.32 * spike) *
                                   mix(0.20, 1.0, interface_band);
                stress += chain_visc *
                    (along_rate * outer2(field_dir, field_dir) +
                     0.22 * across_rate * outer2(field_tangent, field_tangent));

                // Surface-aware Rosensweig surrogate: use a lightweight
                // occupancy texture of the ferro phase so the magnetic
                // term acts mostly at the liquid interface instead of
                // squeezing the whole puddle uniformly.
                if (interface_band > 1e-4) {
                    vec2 n_in = occ_grad / max(occ_grad_mag, 1e-5);
                    vec2 n_out = -n_in;
                    vec2 t_int = vec2(-n_out.y, n_out.x);
                    float normal_align = abs(dot(field_dir, n_out));
                    float tangent_align = abs(dot(field_dir, t_int));
                    float corrugation = max(u_mag_assist_corrugation_strength, 0.0);
                    float ridge_freq = max(u_magnet_spike_freq, 1.0);
                    vec2 ridge_axis = normalize(field_tangent + vec2(1e-6, 0.0));
                    float ridge_phase = dot(pos, ridge_axis) * ridge_freq +
                                        dot(pos, field_dir) * ridge_freq * 0.08;
                    float ridge_wave = 0.5 + 0.5 * sin(ridge_phase);
                    float ridge = pow(ridge_wave, 5.0);
                    float trough = pow(1.0 - ridge_wave, 2.0);
                    float ridge_signed = ridge - 0.56 * trough;
                    float ridge_surface_gate = abs(dot(ridge_axis, t_int));
                    float ridge_gain = max(0.18, 1.0 + 1.05 * corrugation *
                                           ridge_signed * ridge_surface_gate);
                    float surface_push = B_mod * interface_band *
                                         (0.08 * chain + 0.74 * spike) *
                                         (0.25 + 0.75 * sat) *
                                         normal_align * normal_align *
                                         mag_gate * mag_gate *
                                         (1.0 + 0.55 * assist_spike) *
                                         ridge_gain;
                    float rim_hold = B_mod * interface_band *
                                     (0.05 + 0.13 * chain + 0.06 * spike) *
                                     (0.30 + 0.70 * tangent_align * tangent_align) *
                                     mag_gate * mag_gate *
                                     (1.0 + 0.20 * assist_spike) *
                                     max(0.40, 1.0 + 0.42 * corrugation *
                                           ridge_signed * ridge_surface_gate);
                    stress -= surface_push *
                              (outer2(n_out, n_out) - 0.30 * outer2(t_int, t_int));
                    stress -= rim_hold * outer2(field_dir, field_dir);

                    float normal_rate = dot(n_out, D * n_out);
                    float tangent_rate = dot(t_int, D * t_int);
                    float interface_visc = mu_visc * interface_band *
                                           (0.16 + 0.48 * spike) *
                                           mix(0.55, 1.0, mag_gate) *
                                           (1.0 + 0.10 * assist_spike) *
                                           mix(1.0, 0.42, clamp(corrugation / 4.0, 0.0, 1.0));
                    stress += interface_visc *
                              (normal_rate * outer2(n_out, n_out) +
                               0.30 * tangent_rate * outer2(t_int, t_int));
                }
            }
        }

        // (Stateless per-particle: the fluid's only state is F, J, pos.)
    }
    else if (mat_type == MAT_MAG_SOFT_IRON || mat_type == MAT_MAGNETIC_RUBBER ||
             mat_type == MAT_SUPERCONDUCTOR || mat_type == MAT_CURIE_FERRO ||
             mat_type == MAT_EDDY_COPPER || mat_type == MAT_HARD_MAGNET) {
        bool soft_rubber = (mat_type == MAT_MAGNETIC_RUBBER);
        // Hard magnet (magnetite-like) is brittle-stiff; superconductor
        // very stiff when cold; eddy copper moderate.
        float stiff_mul = soft_rubber ? 0.65
                        : (mat_type == MAT_EDDY_COPPER ? 3.20
                        : (mat_type == MAT_SUPERCONDUCTOR ? 5.80
                        : (mat_type == MAT_HARD_MAGNET ? 5.40
                        : 4.80)));
        float E_mag = E * stiff_mul;
        float nu_mag = soft_rubber ? 0.36 : 0.34;
        float mu_mag = E_mag / (2.0 * (1.0 + nu_mag));
        float lam_mag = E_mag * nu_mag / ((1.0 + nu_mag) * (1.0 - 2.0 * nu_mag));
        stress = 2.0 * mu_mag * (F - R) * transpose(F)
               + lam_mag * (J - 1.0) * J * mat2(1.0);

        if (u_use_real_magnetics != 0) {
            vec4 drive_local = sample_magnetic_drive_field_smooth(pos);
            vec4 total_local = sample_magnetic_total_field_smooth(pos);
            vec4 drive_bulk = vec4(0.0);
            vec2 grad_h2 = vec2(0.0);
            float grad_mag = 0.0;
            float rigid_gate = magnetic_drive_response_gate(pos, drive_bulk, grad_h2, grad_mag);
            float wall_gate = magnetic_wall_gate(pos, 0.22);
            vec2 drive_vec = mix(drive_local.xy, drive_bulk.xy, 0.70);
            float total_align = clamp(total_local.z / max(drive_local.z, 1e-4), 0.0, 1.0);
            vec2 align_vec = mix(drive_vec, total_local.xy, 0.76 * total_align);
            float hmag = mix(drive_local.z, drive_bulk.z, 0.76);
            if (hmag > 1e-4) {
                vec2 field_dir = normalize(align_vec + vec2(1e-6, 0.0));
                vec2 field_tangent = vec2(-field_dir.y, field_dir.x);
                float sat = 1.0 - exp(-hmag * (soft_rubber ? 0.16 : 0.26));
                float align = clamp(sat * rigid_gate * wall_gate, 0.0, soft_rubber ? 0.42 : 0.72);
                float compression = max(1.0 - J, 0.0);
                float grad_term = clamp(grad_mag / (hmag * hmag + 1e-4), 0.0, 2.8);
                if (soft_rubber) {
                    float eps_parallel = 0.032 * align;
                    float eps_perp = -eps_parallel * 0.52;
                    mat2 F_target = mat2(1.0)
                                  + eps_parallel * outer2(field_dir, field_dir)
                                  + eps_perp * outer2(field_tangent, field_tangent);
                    float mag_shape = max(E_mag * 0.16, 150.0) * (0.35 + 0.65 * align);
                    stress += mag_shape * (F_target - F) * transpose(F);

                    float pole_lock = max(E_mag * 0.08, 70.0)
                                    * (0.14 + 0.56 * grad_term * align);
                    float anti_collapse = max(E_mag * 0.18, 180.0)
                                        * (0.30 + compression * (1.5 + align));
                    float bend_hold = max(E_mag * 0.10, 90.0) * (0.20 + 0.80 * align);
                    mat2 D = 0.5 * (C + transpose(C));
                    float along_rate = dot(field_dir, D * field_dir);
                    float across_rate = dot(field_tangent, D * field_tangent);
                    stress += pole_lock * outer2(field_dir, field_dir);
                    stress += (pole_lock * 0.28) * outer2(field_tangent, field_tangent);
                    stress -= mat2(anti_collapse * max(1.0 - J, 0.0));
                    stress += bend_hold *
                              (along_rate * outer2(field_dir, field_dir) +
                               0.55 * across_rate * outer2(field_tangent, field_tangent));
                } else {
                    // Soft iron should behave like a stiff coherent body whose
                    // bulk motion comes from the external Kelvin pull, not like
                    // a contracting magnetic actuator. Keep only stiffening and
                    // anti-collapse support here.
                    float field_stiffen = 1.0 + 1.2 * align;
                    stress *= field_stiffen;
                    float anti_collapse = max(E_mag * 0.46, 2200.0)
                                        * (0.35 + compression * (2.4 + 0.6 * align));
                    float shape_hold = max(E_mag * 0.22, 900.0) * (0.30 + 0.70 * align);
                    mat2 D = 0.5 * (C + transpose(C));
                    float along_rate = dot(field_dir, D * field_dir);
                    float across_rate = dot(field_tangent, D * field_tangent);
                    stress -= mat2(anti_collapse * max(1.0 - J, 0.0));
                    stress += shape_hold * (mat2(1.0) - F) * transpose(F);
                    stress += max(E_mag * 0.14, 700.0) *
                              (along_rate * outer2(field_dir, field_dir) +
                               0.42 * across_rate * outer2(field_tangent, field_tangent));
                }
            }
        }
    }
    else if (mat_type == MAT_SNOW) {
        float theta_c = 2.5e-2, theta_s = 4.5e-3;
        vec2 new_sig = clamp(svd.sigma, vec2(1.0 - theta_c), vec2(1.0 + theta_s));
        float Jp = Jp_data[idx];
        Jp *= (svd.sigma.x * svd.sigma.y) / (new_sig.x * new_sig.y);
        Jp_data[idx] = clamp(Jp, 0.6, 20.0);
        svd.sigma = new_sig;
        F = svd.U * mat2(svd.sigma.x, 0, 0, svd.sigma.y) * transpose(svd.V);
        J = new_sig.x * new_sig.y;
        float h = clamp(exp(10.0 * (1.0 - Jp)), 0.1, 5.0);
        R = svd.U * transpose(svd.V);
        stress = 2.0 * mu * h * (F - R) * transpose(F)
               + lambda * h * (J - 1.0) * J * mat2(1.0);
    }
    else if (mat_type == MAT_BRITTLE || mat_type == MAT_TOUGH) {
        bool is_tough = (mat_type == MAT_TOUGH);
        float thermal = clamp((temp - 380.0) / 320.0, 0.0, 1.0);
        float E_eff = E * (is_tough ? 1.15 : 0.95) * (1.0 - thermal * (is_tough ? 0.18 : 0.08));
        float nu_eff = clamp(nu * (is_tough ? 1.0 : 0.85), 0.08, 0.34);
        float mu_s = E_eff / (2.0 * (1.0 + nu_eff));
        float lam_s = E_eff * nu_eff / ((1.0 + nu_eff) * (1.0 - 2.0 * nu_eff));

        if (use_frac && fp_allow) {
            // --- Aniso Fracture v1 (AnisoMPM) -------------------------------
            // Build the three stress pieces SEPARATELY so the driving force sees the
            // UNDEGRADED stress and the degradation can be selective. The legacy path
            // below sums them into one tensor and then multiplies the whole thing --
            // including the fiber term -- which is why legacy tears go limp.
            mat2 tau_mu  = 2.0 * mu_s * (F - R) * transpose(F);
            mat2 tau_lam = lam_s * (J - 1.0) * J * mat2(1.0);
            mat2 tau_fib = mat2(0.0);
            vec2 fiber = fiber_dirs[idx];
            if (length(fiber) > 0.3 && fiber_strength > 0.1) {
                vec2 df = F * fiber;
                float fs = length(df);
                if (fs > 1e-6) {
                    vec2 fh = df / fs;
                    float fi = clamp(fs - 1.0, -0.35, 0.35);
                    tau_fib = fiber_strength * mu_s * fi * mat2(
                        fh.x*fh.x, fh.x*fh.y, fh.y*fh.x, fh.y*fh.y);
                }
            }
            float d = damage[idx];
            float g = aniso_damage_step(idx, tau_mu + tau_lam + tau_fib, J, R, fiber,
                                        mu_s, lam_s, fpA, fpB, d);
            damage[idx] = d;
            g_applied = g;
            // Selective degradation (AnisoMPM): shear always; volumetric only in
            // TENSION (so cracked fragments still push apart instead of
            // interpenetrating); the fiber term NEVER -- intact fibers surviving a
            // failed matrix is what makes a tear stringy.
            stress = g * tau_mu + ((J > 1.0) ? g : 1.0) * tau_lam + tau_fib;
        } else {
        stress = 2.0 * mu_s * (F - R) * transpose(F)
               + lam_s * (J - 1.0) * J * mat2(1.0);

        vec2 fiber = fiber_dirs[idx];
        float along_strain = 0.0;
        float cross_strain = 0.0;
        if (length(fiber) > 0.3 && fiber_strength > 0.1) {
            vec2 df = F * fiber;
            float fs = length(df);
            if (fs > 1e-6) {
                vec2 fh = df / fs;
                float fi = clamp(fs - 1.0, -0.35, 0.35);
                stress += fiber_strength * mu_s * fi * mat2(
                    fh.x*fh.x, fh.x*fh.y, fh.y*fh.x, fh.y*fh.y);
                along_strain = abs(fs - 1.0);
                vec2 perp = vec2(-fiber.y, fiber.x);
                cross_strain = abs(length(F * perp) - 1.0);
            }
        }

        float d = damage[idx];
        float tensile = max(max(svd.sigma.x, svd.sigma.y) - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y);
        float crack_thresh = is_tough ? 0.13 : 0.055;
        crack_thresh *= (1.0 - thermal * (is_tough ? 0.25 : 0.45));
        float crack_rate = is_tough ? 1.8 : 4.8;
        crack_rate *= 1.0 + thermal * (is_tough ? 0.7 : 1.6);
        float directional = max(cross_strain - along_strain * 0.35, 0.0);
        float crack_drive = max(
            tensile * (is_tough ? 0.8 : 1.2) +
            shear * (is_tough ? 0.55 : 0.85) +
            directional * 0.6 - crack_thresh, 0.0);
        d += crack_drive * crack_rate * u_dt;
        d = clamp(d, 0.0, 1.0);
        damage[idx] = d;

        float matrix_loss = max(1.0 - d * (is_tough ? 0.35 : 0.55), is_tough ? 0.65 : 0.42);
        stress *= matrix_loss;
        if (d > 0.72) {
            float bond_loss = smoothstep(0.72, 1.0, d);
            stress *= mix(1.0, is_tough ? 0.55 : 0.30, bond_loss);
        }
        }
    }
    else if (mat_type == MAT_GLASS) {
        float soft = phase_data[idx];
        float crack = damage[idx];
        float glass_hold = clamp(0.50 * pseudo_depth + 0.60 * pseudo_shell + 0.50 * pseudo_cohesion, 0.0, 2.0);

        float target_soft = smoothstep(720.0, 980.0, temp);
        soft += clamp(target_soft - soft, -1.6 * u_dt, 1.8 * u_dt);
        soft = clamp(soft, 0.0, 1.0);
        phase_data[idx] = soft;

        float hot_floor = mix(0.55, 0.78, clamp(glass_hold * 0.45, 0.0, 1.0));
        float E_g = mix(E * (3.4 + 0.20 * glass_hold), E * hot_floor, soft)
                  * mix(1.0, pseudo_shell_boost, 0.12 + 0.34 * (1.0 - soft));
        float nu_g = mix(0.17, mix(0.31, 0.28, clamp(glass_hold * 0.40, 0.0, 1.0)), soft);
        float mu_g = E_g / (2.0 * (1.0 + nu_g));
        float lam_g = E_g * nu_g / ((1.0 + nu_g) * (1.0 - 2.0 * nu_g));

        mat2 elastic_stress = 2.0 * mu_g * (F - R) * transpose(F)
                            + lam_g * (J - 1.0) * J * mat2(1.0);
        float J_rest = 1.0 + soft * max(temp - 760.0, 0.0) * 0.00006;
        mat2 liquid_stress = mat2(lam_g * J * (J - J_rest));
        float blend = smoothstep(0.86 + 0.08 * clamp(glass_hold * 0.45, 0.0, 1.0), 1.0, soft);
        stress = elastic_stress * (1.0 - blend) + liquid_stress * blend;

        if (soft > 0.35 && soft < 0.98) {
            float viscosity = max(E * 0.24 * (1.0 - abs(soft - 0.78) * 1.1) * (1.0 + 0.35 * pseudo_depth), 0.0);
            stress += viscosity * (C + transpose(C));
        }
        if (soft > 0.92) {
            float relax = smoothstep(0.92, 1.0, soft) * 0.015 * mix(1.0, 0.55, clamp(pseudo_cohesion * 0.65, 0.0, 1.0));
            mat2 F_iso = mat2(sqrt(max(J, 0.01)));
            F = F * (1.0 - relax) + F_iso * relax;
        }

        float tensile = max(max(svd.sigma.x, svd.sigma.y) - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y);
        float crack_thresh = mix(0.028, 0.11, soft) * pseudo_split_hold
                           + 0.012 * clamp(pseudo_shell * 0.60, 0.0, 1.0) * (1.0 - soft);
        float crack_rate = mix(9.0, 1.2, soft) * mix(1.0, 0.72, clamp(pseudo_cohesion * 0.70, 0.0, 1.0));
        crack += max(tensile * 1.6 + shear * 1.2 - crack_thresh, 0.0) * crack_rate * u_dt;
        crack = clamp(crack, 0.0, 1.0);
        damage[idx] = crack;

        float integrity_floor = 0.18 + soft * 0.2 + clamp(glass_hold * 0.08, 0.0, 0.16) * (1.0 - soft * 0.5);
        float integrity = max(1.0 - crack * mix(0.82, 0.62, clamp(pseudo_cohesion * 0.80, 0.0, 1.0)), integrity_floor);
        stress *= integrity;
        if (crack > 0.70) {
            float shatter = smoothstep(0.70, 1.0, crack);
            stress *= mix(1.0, mix(0.18, 0.30, clamp(pseudo_cohesion * 0.80, 0.0, 1.0)), shatter);
        }
    }
    else if (mat_type == MAT_ANISO || mat_type == MAT_FRACTURE) {
        // Only apply heat effects if material HAS fibers (fiber_strength > 0)
        // Glass/non-fiber fracture materials are NOT affected by temperature
        bool has_fibers = (length(fiber_dirs[idx]) > 0.3 && fiber_strength > 0.1);
        float heat_effect = 0.0;
        float char_level = 0.0;

        if (has_fibers && temp > 350.0) {
            heat_effect = clamp((temp - 350.0) / 400.0, 0.0, 1.0);
            char_level = clamp((temp - 500.0) / 300.0, 0.0, 1.0);
            // Fire v3 (crack<->burn): a mechanically strained / cracking region
            // exposes fresh surface, so it chars faster where it is hot.
            if (u_fire_structural == 1) {
                float strain_expose = clamp(length(svd.sigma - vec2(1.0)) * 1.5, 0.0, 1.0);
                char_level = clamp(char_level + strain_expose * 0.4 * heat_effect, 0.0, 1.0);
            }
        }

        // Heat strongly weakens the matrix so ropes/woods visibly lose structure.
        float E_eff = E * mix(1.0, 0.28, heat_effect);
        float mu_s = E_eff / (2.0 * (1.0 + nu));
        float lam_s = E_eff * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));

        stress = 2.0 * mu_s * (F - R) * transpose(F)
               + lam_s * (J - 1.0) * J * mat2(1.0);

        // Fiber reinforcement (weakens with heat)
        vec2 fiber = fiber_dirs[idx];
        vec2 df = F * fiber;
        float fs = length(df);
        if (fs > 1e-6 && fiber_strength > 0.1) {
            float fiber_eff = fiber_strength * (1.0 - char_level * 0.8);
            vec2 fh = df / fs;
            float fi = clamp(fs - 1.0, -0.5, 0.5);
            stress += fiber_eff * mu_s * fi * mat2(
                fh.x*fh.x, fh.x*fh.y, fh.y*fh.x, fh.y*fh.y);
        }

        // ANISO: store charring for visual
        if (mat_type == MAT_ANISO && has_fibers) {
            float charred = max(damage[idx], char_level);
            damage[idx] = charred;
            float base_rigid = smoothstep(9000.0, 18000.0, E);
            float char_soft = mix(0.28, 0.58, base_rigid);
            float char_brittle = mix(0.0, 0.35, base_rigid) * smoothstep(0.35, 0.95, charred);
            stress *= max(1.0 - charred * char_soft - char_brittle, 0.12);
            if (charred > 0.55) {
                float relax = smoothstep(0.55, 0.95, charred) * mix(0.10, 0.03, base_rigid);
                F = F * (1.0 - relax) + R * relax;
            }
            // Fire v3 (char->sever): a charred-through section loses almost all
            // load and relaxes toward a free chunk, so a burning beam snaps at
            // the burnt span instead of going uniformly limp.
            if (u_fire_structural == 1) {
                float sever = smoothstep(0.45, 0.95, charred) * u_char_fracture_gain;
                stress *= (1.0 - 0.85 * sever);
                if (sever > 0.0) {
                    float relax = sever * 0.25;
                    F = F * (1.0 - relax) + mat2(sqrt(max(J, 0.01))) * relax;
                    C *= (1.0 - relax * 0.5);
                }
            }
        }

        // FRACTURE: damage from strain (heat only affects fibered materials)
        if (mat_type == MAT_FRACTURE) {
            float d = damage[idx];
            float strain_mag = length(svd.sigma - vec2(1.0));
            float thresh = fracture_threshold;
            float rate = fracture_rate;
            if (has_fibers) {
                thresh *= (1.0 - heat_effect * 0.5);
                rate *= (1.0 + heat_effect * 2.0);
                d = max(d, char_level * 0.5);
            } else if (temp > 350.0) {
                float heat_brittleness = clamp((temp - 350.0) / 350.0, 0.0, 1.0);
                thresh *= (1.0 - heat_brittleness * 0.6);
                rate *= (1.0 + heat_brittleness * 1.8);
            }
            // Fire v3 (char->fail): charred fracture material drops its threshold
            // and accumulates damage directly, so the burnt cross-section fails.
            if (u_fire_structural == 1) {
                float sever = smoothstep(0.40, 0.90, char_level) * u_char_fracture_gain;
                thresh *= (1.0 - 0.6 * sever);
                d = max(d, sever);
            }
            d += max(strain_mag - thresh, 0.0) * rate * u_dt;
            d = clamp(d, 0.0, 1.0);
            damage[idx] = d;
            float coupling = max(1.0 - d * 0.82, 0.18);
            stress *= coupling;
            if (d > 0.75) {
                float relax = smoothstep(0.75, 1.0, d) * 0.2;
                mat2 F_chunk = mat2(sqrt(max(J, 0.01)));
                F = F * (1.0 - relax) + F_chunk * relax;
                C *= (1.0 - relax * 0.5);
            }
        }
    }
    else if (mat_type == MAT_ORTHO_BEND || mat_type == MAT_ORTHO_TEAR) {
        vec2 fiber = normalize(fiber_dirs[idx] + vec2(1e-6, 0.0));
        vec2 perp = vec2(-fiber.y, fiber.x);
        vec2 df = F * fiber;
        vec2 dp = F * perp;
        float fs = max(length(df), 1e-6);
        float ps = max(length(dp), 1e-6);
        vec2 fh = df / fs;
        vec2 ph = dp / ps;
        float along = fs - 1.0;
        float across = ps - 1.0;
        float shear = dot(df, dp);

        float cure = 0.0;
        float crack = 0.0;
        float heat = 0.0;
        float ortho_hold = 0.0;
        if (mat_type == MAT_ORTHO_TEAR) {
            cure = damage[idx];
            crack = Jp_data[idx];
            heat = smoothstep(360.0, 680.0, temp);
            ortho_hold = clamp(0.45 * pseudo_depth + 0.35 * pseudo_shell + 0.45 * pseudo_cohesion, 0.0, 2.0);
            if (temp > 360.0) {
                cure += mix(0.08, 0.38, shell_seed) * heat * u_dt * (1.0 - cure);
            }
            cure = clamp(cure, 0.0, 1.0);
        }

        float matrix_scale = (mat_type == MAT_ORTHO_BEND) ? 0.08 : mix(0.12, 0.20, cure);
        float along_scale = (mat_type == MAT_ORTHO_BEND) ? (1.2 + fiber_strength * 2.6)
                                                         : (1.3 + fiber_strength * (2.0 + cure * 0.8));
        float cross_scale = (mat_type == MAT_ORTHO_BEND) ? 0.05
                                                         : mix(0.10, 0.04, cure);
        float shear_scale = (mat_type == MAT_ORTHO_BEND) ? 0.06
                                                         : mix(0.10, 0.05, cure);
        if (u_stiffness_v2 == 1) {
            // The unfloored cross/matrix stiffness (5-8% of an already-kPa-scale
            // E) is below the weight of one grid cell of material, so these
            // materials flatten into a line. Floors keep strong anisotropy
            // (along stays 1.2-4x E) but let the cross direction carry at
            // least a few cells of self-weight.
            matrix_scale = max(matrix_scale, 0.30);
            cross_scale = max(cross_scale, 0.18);
            shear_scale = max(shear_scale, 0.15);
        }
        if (mat_type == MAT_ORTHO_TEAR) {
            matrix_scale *= 1.0 + 0.55 * ortho_hold;
            along_scale *= 1.0 + 0.18 * ortho_hold;
            cross_scale *= 1.0 + 0.90 * ortho_hold;
            shear_scale *= 1.0 + 0.75 * ortho_hold;
        }

        float E_iso = E * matrix_scale;
        float mu_iso = E_iso / (2.0 * (1.0 + nu));
        float lam_iso = E_iso * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));
        float E_along = E * along_scale;
        float E_cross = E * cross_scale;
        float E_shear = E * shear_scale;
        float J_rest = 1.0;
        if (mat_type == MAT_ORTHO_TEAR) {
            J_rest += cure * 0.012 - heat * 0.018 / max(1.0, pseudo_enclosure_hold);
        }

        mat2 iso_stress = 2.0 * mu_iso * (F - R) * transpose(F)
                        + lam_iso * (J - J_rest) * J * mat2(1.0);
        mat2 along_stress = E_along * along * mat2(
            fh.x*fh.x, fh.x*fh.y,
            fh.y*fh.x, fh.y*fh.y);
        mat2 cross_stress = E_cross * across * mat2(
            ph.x*ph.x, ph.x*ph.y,
            ph.y*ph.x, ph.y*ph.y);
        mat2 shear_stress = E_shear * shear * mat2(
            fh.x*ph.x + ph.x*fh.x, fh.x*ph.y + ph.x*fh.y,
            fh.y*ph.x + ph.y*fh.x, fh.y*ph.y + ph.y*fh.y);
        stress = iso_stress + along_stress + cross_stress + shear_stress;

        if (mat_type == MAT_ORTHO_BEND) {
            damage[idx] = clamp(abs(across) * 0.35 + abs(shear) * 0.20, 0.0, 1.0);
        } else if (use_frac && fp_allow) {
            // --- Aniso Fracture v1 (AnisoMPM) on the flagship tear material ------
            // The legacy drive below (cross*3.2 + shear*1.8 - along*0.80 - thresh) is
            // an unnormalized hand-rolled approximation of the cross-fiber projector
            // A = I - a^a. AnisoMPM at alpha = -1 IS that projector, done properly:
            // along-fiber tension contributes exactly nothing, so cracks run ALONG
            // the grain, and the l0^2*Lap(d) term gives the crack a real tip that
            // propagates instead of a field of independently-tripped particles.
            damage[idx] = cure;
            phase_data[idx] = abs(across);
            float g = aniso_damage_step(idx, stress, J, R, fiber,
                                        mu_iso, lam_iso, fpA, fpB, crack);
            Jp_data[idx] = crack;
            g_applied = g;
            // Keep the four-piece split (already the right shape here), but drive it
            // from g and NEVER degrade the along-fiber term -- that is what leaves
            // load-bearing fiber bundles behind a tear instead of a limp strip.
            // iso_stress bundles a deviatoric and a volumetric term, so it has to be
            // rebuilt rather than scaled: the volumetric piece is degraded only in
            // TENSION, exactly as the sibling BRITTLE/TOUGH branch above does. Scaling
            // the sum would degrade it in compression too, which lets cracked fragments
            // sink into each other instead of pushing apart.
            mat2 iso_dev = 2.0 * mu_iso * (F - R) * transpose(F);
            mat2 iso_vol = lam_iso * (J - J_rest) * J * mat2(1.0);
            iso_stress   = g * iso_dev + ((J > 1.0) ? g : 1.0) * iso_vol;
            cross_stress *= g;
            shear_stress *= g;
            stress = iso_stress + along_stress + cross_stress + shear_stress;
        } else {
            float cross_mag = abs(across);
            float along_mag = abs(along);
            float shear_mag = abs(shear);
            float crack_thresh = mix(0.10, 0.05, heat) * mix(1.0, 0.75, cure) * pseudo_split_hold
                               + pseudo_shell * 0.04;
            float crack_drive = max(cross_mag * 3.2 + shear_mag * 1.8 + heat * 0.10 - along_mag * 0.80 - crack_thresh, 0.0);
            crack += crack_drive * (0.35 + cure * 1.25 + heat * 1.35) * (1.0 / max(1.0, pseudo_split_hold)) * u_dt;
            crack = clamp(crack, 0.0, 1.0);

            damage[idx] = cure;
            phase_data[idx] = cross_mag;
            Jp_data[idx] = crack;

            if (crack > 0.22) {
                float split = smoothstep(0.22, 1.0, crack);
                float residual = clamp(pseudo_cohesion * 0.80, 0.0, 1.0);
                iso_stress *= mix(1.0, mix(0.28, 0.46, residual), split);
                cross_stress *= mix(1.0, mix(0.04, 0.16, residual), split);
                shear_stress *= mix(1.0, mix(0.10, 0.24, residual), split);
                along_stress *= mix(1.0, mix(0.58, 0.72, residual), split);
                stress = iso_stress + along_stress + cross_stress + shear_stress;
            }
        }
    }
    else if (mat_type == MAT_PHASE) {
        // Phase-field: interpolate solid↔liquid based on temperature
        float phi = phase_data[idx];
        float T_s = u_melt_temp - u_melt_range * 0.5;
        float T_l = u_melt_temp + u_melt_range * 0.5;
        float target = clamp((temp - T_s) / (T_l - T_s), 0.0, 1.0);
        float dphi = clamp(target - phi, -2.0 * u_dt, 2.0 * u_dt);
        phi = clamp(phi + dphi, 0.0, 1.0);
        phase_data[idx] = phi;

        // Latent heat
        temperatures[p] = clamp(temp - dphi * u_latent_heat, 0.0, 1500.0);

        // Thermal expansion: liquid wants to occupy more volume
        float expansion = 1.0 + phi * max(temp - u_melt_temp, 0.0) * 0.001;
        float J_rest = expansion; // Rest-state volume ratio

        // Interpolate stiffness (keep minimum lambda for liquid body)
        float sf = (1.0 - phi);
        float E_eff = max(E * sf * sf * sf, E * 0.02); // 2% floor so liquid isn't infinitely soft
        float mu_p = E_eff / (2.0 * (1.0 + nu));
        float lam_p = E_eff * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));

        // Glass transition: smooth interpolation between solid and liquid
        // phi=0: full elastic solid
        // phi=0.3-0.7: "glass transition zone" - viscous, deformable, partially elastic
        // phi=1: fully liquid
        mat2 elastic_stress = 2.0 * mu_p * (F - R) * transpose(F)
                            + lam_p * (J - 1.0) * J * mat2(1.0);

        // In the transition zone, partially reset F toward isotropic
        // This models the loss of elastic memory (glass → liquid)
        float reset_fraction = smoothstep(0.3, 0.9, phi);
        mat2 F_isotropic = mat2(sqrt(max(J, 0.01)));
        float rf = reset_fraction * 0.3;
        F = F * (1.0 - rf) + F_isotropic * rf;

        // Liquid stress (volumetric only)
        float J_iso = max(determinant(F), 0.01);
        mat2 liquid_stress = mat2(lam_p * J_iso * (J_iso - J_rest));

        // Smoothly blend: elastic → viscous → liquid
        float blend = smoothstep(0.2, 0.95, phi);
        stress = elastic_stress * (1.0 - blend) + liquid_stress * blend;

        // Add viscous damping in the transition zone (glass-like)
        // Uses the velocity gradient (C matrix) as a proxy for strain rate
        if (phi > 0.1 && phi < 0.95) {
            float viscosity = mu_p * 0.5 * (1.0 - abs(phi - 0.5) * 2.0);
            stress += viscosity * (C + transpose(C)); // Viscous stress from strain rate
        }

        mu = mu_p; lambda = lam_p;
    }
    else if (mat_type == MAT_MEMORY_WAX) {
        float soft = phase_data[idx];
        float recover = damage[idx];

        float target_soft = smoothstep(320.0, 470.0, temp);
        soft += clamp(target_soft - soft, -2.2 * u_dt, 2.6 * u_dt);
        soft = clamp(soft, 0.0, 1.0);
        phase_data[idx] = soft;

        float cool_recover = 1.0 - smoothstep(0.04, 0.42, soft);
        recover += (cool_recover - recover) * 1.6 * u_dt;
        recover = clamp(recover, 0.0, 1.0);
        damage[idx] = recover;
        Jp_data[idx] *= max(1.0 - 0.9 * u_dt, 0.0);

        float E_mw = mix(E * 1.30, E * 0.10, soft);
        float nu_mw = clamp(mix(0.24, 0.39, soft), 0.16, 0.42);
        float mu_mw = E_mw / (2.0 * (1.0 + nu_mw));
        float lam_mw = E_mw * nu_mw / ((1.0 + nu_mw) * (1.0 - 2.0 * nu_mw));
        float J_rest = 1.0 + soft * 0.035;

        mat2 elastic_stress = 2.0 * mu_mw * (F - R) * transpose(F)
                            + lam_mw * (J - 1.0) * J * mat2(1.0);
        mat2 liquid_stress = mat2(lam_mw * J * (J - J_rest));
        float blend = smoothstep(0.72, 0.98, soft);
        stress = elastic_stress * (1.0 - blend) + liquid_stress * blend;

        if (soft > 0.45) {
            stress += mu_mw * mix(0.08, 0.38, soft) * (C + transpose(C));
        }
        if (recover > 0.05) {
            float restore = mix(0.010, 0.11, recover) * (1.0 - soft);
            mat2 F_rest = mat2(1.0);
            F = F * (1.0 - restore) + F_rest * restore;
            svd = svd2x2(F);
            R = svd.U * transpose(svd.V);
            J = svd.sigma.x * svd.sigma.y;
            stress += E * recover * 0.06 * (mat2(1.0) - F);
        }
    }
    else if (mat_type == MAT_BURNING) {
        // Combustion: solid → burning → hot gas → ash
        float burn = damage[idx];
        float batch_heat = max(thermal_params.y, 0.1);
        float batch_cooling = max(thermal_params.z, 0.02);
        float batch_loft = max(thermal_params.w, 0.0);
        // Fire v3: oxygen gates combustion. sample_oxygen returns 1.0 when the
        // feature is off, so oxy_gate == 1.0 and behavior is unchanged.
        float oxy_air = sample_oxygen(pos);
        float oxy_gate = smoothstep(0.06, 0.45, oxy_air);
        if (u_fire_smolder == 1) oxy_gate *= mix(1.0, 0.4, 1.0 - smoothstep(u_smolder_o2_lo * 0.5, u_smolder_o2_lo, oxy_air));

        // Ignition. Burn Front v2: per-particle jitter on ignition temp and
        // burn speed breaks the deterministic lockstep that made whole bands
        // ignite on the same frame, and a faster burn-through makes the front
        // thin (burn duration < layer-to-layer conduction lag) instead of the
        // whole object burning in one phase.
        float ign_h0 = hash1(vec2(float(p) * 0.7311, 17.93));
        float ign_h1 = hash1(vec2(float(p) * 1.3771, 43.17));
        float ignition_T = 370.0;
        float rate_scale = 1.0;
        if (u_burn_front_v2 == 1) {
            ignition_T += (ign_h0 - 0.5) * u_burn_ignition_jitter;
            rate_scale = u_burn_rate_scale * mix(0.75, 1.25, ign_h1);
        }
        if (temp > ignition_T && burn < 1.0) {
            float fuel_hold = mix(0.54, 0.96, clamp(batch_cooling, 0.0, 1.2));
            float ignition = clamp((temp - (ignition_T - 10.0)) / 250.0, 0.0, 1.0);
            float burn_drag = mix(1.0, 0.58, smoothstep(0.16, 0.84, burn));
            burn += 0.42 * rate_scale * fuel_hold * burn_drag * ignition * oxy_gate * u_dt;
        }

        // Exothermic: strong enough to sustain against grid cooling
        if (burn > 0.01 && burn < 0.985) {
            float flame = clamp(burn * (1.0 - burn) * 4.0, 0.0, 1.0);
            float heat_output = (860.0 + 220.0 * batch_heat) * flame * oxy_gate;
            if (u_burn_front_v2 == 1) {
                // Bounded exothermic self-heating only — no temperature floor.
                // The legacy floor (else branch) teleports a barely-ignited
                // particle (burn = 0.011) straight to >=505 K, which both
                // smears the front (every touched particle instantly becomes
                // a full-power heat source) and makes fire physically
                // unextinguishable. The sustain gate lets active cooling
                // actually smother the flame.
                float sustain = smoothstep(330.0, 380.0, temp);
                temp += heat_output * sustain * u_dt;
            } else {
                temp += heat_output * u_dt;
                // Burning particles resist grid cooling (they're ON FIRE)
                temp = max(temp, 505.0 + 60.0 * min(batch_heat, 1.5) + 35.0 * flame); // Never drop below ignition while actively burning
            }
        }

        // Ash cools (slowly)
        if (burn > 0.94) {
            temp += (340.0 - temp) * mix(0.040, 0.012, clamp(batch_cooling, 0.0, 1.0)) * u_dt;
        }

        burn = clamp(burn, 0.0, 1.0);
        damage[idx] = burn;
        temperatures[p] = clamp(temp, 0.0, 1200.0);

        // Stiffness drops gradually
        float E_burn = E * max(1.0 - burn * 0.9, 0.05);
        float mu_b = E_burn / (2.0 * (1.0 + nu));
        float lam_b = E_burn * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));

        // Anneal F as material burns (release locked deformation)
        if (burn > 0.1) {
            float anneal = burn * 0.3 * u_dt;
            F = F * (1.0 - anneal) + R * anneal;
            svd = svd2x2(F);
            R = svd.U * transpose(svd.V);
            J = svd.sigma.x * svd.sigma.y;
        }

        if (burn > 0.92 + 0.04 * clamp(batch_loft, 0.0, 1.0)) {
            // Gas: zero stress, zero affine, damp velocity
            F = mat2(sqrt(max(J, 0.01)));
            J = max(J, 0.01);
            stress = mat2(0.0);
            C = mat2(0.0);
        } else {
            // Solid, weakening
            stress = 2.0 * mu_b * (F - R) * transpose(F)
                   + lam_b * (J - 1.0) * J * mat2(1.0);

            vec2 fiber = fiber_dirs[idx];
            if (length(fiber) > 0.5) {
                vec2 df = F * fiber;
                float fs = length(df);
                if (fs > 1e-6) {
                    vec2 fh = df / fs;
                    float fi = clamp(fs - 1.0, -0.5, 0.5);
                    float fiber_E = fiber_strength * mu_b * (1.0 - burn);
                    stress += fiber_E * fi * mat2(fh.x*fh.x, fh.x*fh.y, fh.y*fh.x, fh.y*fh.y);
                }
            }
        }
    }
    else if (mat_type == MAT_EMBER) {
        // Embers/sparks: like burning but ash stays HOT much longer
        float burn = damage[idx];
        float ignition_temp = 350.0;
        float batch_heat = max(thermal_params.y, 0.1);
        float batch_cooling = max(thermal_params.z, 0.02);
        float oxy_air = sample_oxygen(pos);
        float oxy_gate = smoothstep(0.06, 0.45, oxy_air);
        if (u_fire_smolder == 1) oxy_gate *= mix(1.0, 0.4, 1.0 - smoothstep(u_smolder_o2_lo * 0.5, u_smolder_o2_lo, oxy_air));

        if (u_burn_front_v2 == 1) {
            ignition_temp += (hash1(vec2(float(p) * 0.7311, 29.41)) - 0.5) * u_burn_ignition_jitter;
        }
        if (temp > ignition_temp && burn < 1.0) {
            burn += 0.95 * mix(0.55, 1.00, clamp(batch_cooling, 0.0, 1.0))
                 * u_dt * oxy_gate * clamp((temp - ignition_temp) / 220.0, 0.0, 1.0);
        }
        // Exothermic (strong — embers are hot!)
        if (burn > 0.01 && burn < 0.985) {
            if (u_burn_front_v2 == 1) {
                // Self-heating without the unquenchable floor (see MAT_BURNING).
                float sustain = smoothstep(320.0, 370.0, temp);
                temp += (820.0 + 180.0 * batch_heat) * clamp(burn * (1.0 - burn) * 4.0, 0.0, 1.0) * sustain * oxy_gate * u_dt;
            } else {
                temp += (820.0 + 180.0 * batch_heat) * clamp(burn * (1.0 - burn) * 4.0, 0.0, 1.0) * oxy_gate * u_dt;
                temp = max(temp, 540.0 + 55.0 * min(batch_heat, 1.5)); // Embers stay HOT
            }
        }
        // Very slow cooling (embers glow for a long time)
        if (burn > 0.90) {
            if (u_burn_front_v2 == 1) {
                // Ash cools to near-ambient instead of being clamped to 410 K
                // forever (the legacy clamp made every ash pile an eternal
                // pilot light and an infinite smoke/heat source).
                temp += (320.0 - temp) * mix(0.020, 0.007, clamp(batch_cooling, 0.0, 1.0)) * u_dt;
            } else {
                temp += (360.0 - temp) * mix(0.010, 0.0035, clamp(batch_cooling, 0.0, 1.0)) * u_dt;
                temp = max(temp, 410.0); // Ash stays warm
            }
        }
        burn = clamp(burn, 0.0, 1.0);
        damage[idx] = burn;
        temperatures[p] = clamp(temp, 0.0, 1200.0);

        float E_e = E * max(1.0 - burn * 0.95, 0.03);
        float mu_e = E_e / (2.0 * (1.0 + nu));
        float lam_e = E_e * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));

        // Anneal during burning
        if (burn > 0.1) {
            float anneal = burn * 0.3 * u_dt;
            F = F * (1.0 - anneal) + R * anneal;
            svd = svd2x2(F);
            R = svd.U * transpose(svd.V);
            J = svd.sigma.x * svd.sigma.y;
        }

        if (burn > 0.6) {
            F = mat2(sqrt(max(J, 0.01)));
            stress = mat2(0.0);
            C = mat2(0.0);
            vel *= 0.95;
        } else {
            stress = 2.0 * mu_e * (F - R) * transpose(F)
                   + lam_e * (J - 1.0) * J * mat2(1.0);
        }
    }
    else if (mat_type == 88u) {
        // TIMBER_BEAM (Fire v3): anisotropic structural wood that ignites, chars
        // slowly, weakens, and (with Structural fire damage) snaps at the burnt
        // span. damage = burn progress.
        float burn = damage[idx];
        float batch_heat = max(thermal_params.y, 0.1);
        float batch_cooling = max(thermal_params.z, 0.02);
        float oxy_air = sample_oxygen(pos);
        float oxy_gate = smoothstep(0.06, 0.45, oxy_air);
        if (u_fire_smolder == 1) oxy_gate *= mix(1.0, 0.4, 1.0 - smoothstep(u_smolder_o2_lo * 0.5, u_smolder_o2_lo, oxy_air));
        float ignition_T = 500.0;
        if (temp > ignition_T && burn < 1.0) {
            float ignition = clamp((temp - ignition_T) / 250.0, 0.0, 1.0);
            burn += 0.16 * mix(0.6, 1.0, clamp(batch_cooling, 0.0, 1.2)) * ignition * oxy_gate * u_dt;
        }
        if (burn > 0.01 && burn < 0.985) {
            float flame = clamp(burn * (1.0 - burn) * 4.0, 0.0, 1.0);
            float sustain = smoothstep(360.0, 460.0, temp);
            temp += (520.0 + 180.0 * batch_heat) * flame * sustain * oxy_gate * u_dt;
        }
        if (burn > 0.94) temp += (340.0 - temp) * 0.02 * u_dt;
        burn = clamp(burn, 0.0, 1.0);
        damage[idx] = burn;
        temperatures[p] = clamp(temp, 0.0, 1200.0);

        float E_w = E * max(1.0 - burn * 0.85, 0.05);
        float mu_w = E_w / (2.0 * (1.0 + nu));
        float lam_w = E_w * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));
        stress = 2.0 * mu_w * (F - R) * transpose(F) + lam_w * (J - 1.0) * J * mat2(1.0);
        // Grain stiffness along the fiber direction, lost as the wood chars.
        vec2 fiber = fiber_dirs[idx];
        if (length(fiber) > 0.5) {
            vec2 df = F * fiber;
            float fs = length(df);
            if (fs > 1e-6) {
                vec2 fh = df / fs;
                float fi = clamp(fs - 1.0, -0.5, 0.5);
                float fiber_E = fiber_strength * mu_w * (1.0 - burn);
                stress += fiber_E * fi * mat2(fh.x*fh.x, fh.x*fh.y, fh.y*fh.x, fh.y*fh.y);
            }
        }
        // Structural fire damage: the burnt-through span loses load and breaks.
        if (u_fire_structural == 1) {
            float sever = smoothstep(0.5, 0.95, burn) * u_char_fracture_gain;
            stress *= (1.0 - 0.85 * sever);
            if (sever > 0.0) {
                float relax = sever * 0.25;
                F = F * (1.0 - relax) + mat2(sqrt(max(J, 0.01))) * relax;
                C *= (1.0 - relax * 0.5);
            }
        }
    }
    else if (mat_type == 89u || mat_type == 90u) {
        // SMOLDER_PEAT (89) / TINDER_BOX (90) (Fire v3): combustible soft solids.
        // Peat smolders cool and smoky; tinder flashes hotter and off-gasses
        // heavily (priming backdraft via euler_inject). damage = burn progress.
        float burn = damage[idx];
        float batch_heat = max(thermal_params.y, 0.1);
        float oxy_air = sample_oxygen(pos);
        float oxy_gate = smoothstep(0.06, 0.45, oxy_air);
        if (u_fire_smolder == 1) oxy_gate *= mix(1.0, 0.4, 1.0 - smoothstep(u_smolder_o2_lo * 0.5, u_smolder_o2_lo, oxy_air));
        float ignition_T = (mat_type == 89u) ? 360.0 : 340.0;
        float heat_out = (mat_type == 89u) ? 280.0 : 560.0;
        if (temp > ignition_T && burn < 1.0) {
            float ignition = clamp((temp - ignition_T) / 200.0, 0.0, 1.0);
            burn += ((mat_type == 89u) ? 0.30 : 0.55) * ignition * oxy_gate * u_dt;
        }
        if (burn > 0.01 && burn < 0.985) {
            float flame = clamp(burn * (1.0 - burn) * 4.0, 0.0, 1.0);
            float sustain = smoothstep(330.0, 380.0, temp);
            temp += (heat_out + 120.0 * batch_heat) * flame * sustain * oxy_gate * u_dt;
        }
        if (burn > 0.94) temp += (335.0 - temp) * 0.03 * u_dt;
        burn = clamp(burn, 0.0, 1.0);
        damage[idx] = burn;
        temperatures[p] = clamp(temp, 0.0, 1200.0);

        float E_p = E * max(1.0 - burn * 0.9, 0.04);
        float mu_p = E_p / (2.0 * (1.0 + nu));
        float lam_p = E_p * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));
        if (burn > 0.92) {
            F = mat2(sqrt(max(J, 0.01)));
            stress = mat2(0.0);
            C = mat2(0.0);
        } else {
            stress = 2.0 * mu_p * (F - R) * transpose(F) + lam_p * (J - 1.0) * J * mat2(1.0);
        }
    }
    else if (mat_type == MAT_HARDEN) {
        // Heat-curing material: soft → hard when heated
        float cured = damage[idx];

        // Cure when hot
        if (temp > 400.0) {
            float prev = cured;
            cured += 1.0 * u_dt * clamp((temp - 400.0) / 200.0, 0.0, 1.0);
            cured = clamp(cured, 0.0, 1.0);
            // Anneal ONLY during active curing (not constantly!)
            float dcure = cured - prev;
            if (dcure > 0.0) {
                float anneal = dcure * 0.3;
                F = F * (1.0 - anneal) + R * anneal;
                svd = svd2x2(F);
                R = svd.U * transpose(svd.V);
                J = svd.sigma.x * svd.sigma.y;
            }
        }
        damage[idx] = cured;

        // E increases dramatically with curing
        float E_h = E * (1.0 + cured * 4.0);
        float mu_h = E_h / (2.0 * (1.0 + nu));
        float lam_h = E_h * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));

        stress = 2.0 * mu_h * (F - R) * transpose(F)
               + lam_h * (J - 1.0) * J * mat2(1.0);
    }
    else if (mat_type == MAT_CERAMIC) {
        // Ceramic: hardens when heated, then fractures into clean chunks
        // damage = cure fraction, Jp = crack damage
        float cured = damage[idx];
        float crack = Jp_data[idx];

        // Cure when hot
        if (temp > 400.0) {
            float prev = cured;
            cured += 0.8 * u_dt * clamp((temp - 400.0) / 200.0, 0.0, 1.0);
            cured = clamp(cured, 0.0, 1.0);
            float dcure = cured - prev;
            if (dcure > 0.0) {
                float anneal = dcure * 0.2;
                F = F * (1.0 - anneal) + R * anneal;
                svd = svd2x2(F);
                R = svd.U * transpose(svd.V);
                J = svd.sigma.x * svd.sigma.y;
            }
        }
        damage[idx] = cured;

        float E_c = E * (1.0 + cured * 4.0);
        float thermal_brittleness = clamp((temp - 450.0) / 350.0, 0.0, 1.0);
        float strain_mag = length(svd.sigma - vec2(1.0));
        float shear = abs(svd.sigma.x - svd.sigma.y);
        float crack_thresh = fracture_threshold * mix(1.25, 0.45, max(cured, thermal_brittleness));
        float crack_rate = fracture_rate * mix(0.8, 3.0, max(cured, thermal_brittleness));
        float crack_drive = max(strain_mag + shear * 0.9 - crack_thresh, 0.0);
        if (cured > 0.55 && crack_drive > 0.0) {
            crack += crack_drive * crack_rate * u_dt;
        }
        crack = clamp(crack, 0.0, 1.0);
        Jp_data[idx] = crack;

        // KEY: cracked particles stay STIFF but reduce coupling
        // This makes fragments, not dust. Cracked material doesn't
        // go to zero E — it keeps 40% stiffness as rigid chunks.
        float integrity = max(1.0 - crack * 0.75, 0.25);
        float mu_c = (E_c * integrity) / (2.0 * (1.0 + nu));
        float lam_c = (E_c * integrity) * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));

        stress = 2.0 * mu_c * (F - R) * transpose(F)
               + lam_c * (J - 1.0) * J * mat2(1.0);

        // Reduce stress exchange more aggressively than stiffness so hot ceramics
        // separate into chunks instead of collapsing into a soft ribbon.
        if (crack > 0.35) {
            float bond_loss = smoothstep(0.35, 1.0, crack);
            stress *= mix(1.0, 0.18, bond_loss);
        }
    }
    else if (mat_type == MAT_BLOOM) {
        float cured = damage[idx];
        float crack = Jp_data[idx];
        float bloom = phase_data[idx];

        if (temp > 420.0) {
            float prev = cured;
            cured += 0.7 * u_dt * clamp((temp - 420.0) / 220.0, 0.0, 1.0);
            cured = clamp(cured, 0.0, 1.0);
            float dcure = cured - prev;
            if (dcure > 0.0) {
                float anneal = dcure * 0.18;
                F = F * (1.0 - anneal) + R * anneal;
                svd = svd2x2(F);
                R = svd.U * transpose(svd.V);
                J = svd.sigma.x * svd.sigma.y;
            }
        }
        damage[idx] = cured;

        float target_bloom = clamp((temp - 560.0) / 220.0, 0.0, 1.0) * clamp(cured * 1.3 - 0.2, 0.0, 1.0);
        bloom += clamp(target_bloom - bloom, -0.6 * u_dt, 1.8 * u_dt);
        bloom = clamp(bloom, 0.0, 1.0);
        phase_data[idx] = bloom;

        float E_b = E * (1.2 + cured * 4.2);
        float integrity = max(1.0 - crack * 0.7, 0.30);
        float mu_b = (E_b * integrity) / (2.0 * (1.0 + nu));
        float lam_b = (E_b * integrity) * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));
        float J_rest = 1.0 + bloom * cured * 0.22;
        stress = 2.0 * mu_b * (F - R) * transpose(F)
               + lam_b * (J - J_rest) * J * mat2(1.0);

        float tensile = max(max(svd.sigma.x, svd.sigma.y) - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y);
        float crack_thresh = mix(0.11, 0.03, cured) * (1.0 - bloom * 0.4);
        float crack_rate = mix(0.6, 5.0, cured) * (1.0 + bloom * 2.5);
        float crack_drive = max(tensile * 1.2 + shear * 1.4 + bloom * 0.18 - crack_thresh, 0.0);
        crack += crack_drive * crack_rate * u_dt;
        crack = clamp(crack, 0.0, 1.0);
        Jp_data[idx] = crack;

        stress *= max(1.0 - crack * 0.5, 0.35);
        if (crack > 0.35) {
            float petal = smoothstep(0.35, 1.0, crack);
            stress *= mix(1.0, 0.16, petal);
        }
    }
    else if (mat_type == MAT_SPLINTER) {
        float cured = damage[idx];
        float crack = Jp_data[idx];
        float bloom = phase_data[idx];

        if (temp > 430.0) {
            float prev = cured;
            cured += 1.1 * u_dt * clamp((temp - 430.0) / 170.0, 0.0, 1.0);
            cured = clamp(cured, 0.0, 1.0);
            float dcure = cured - prev;
            if (dcure > 0.0) {
                float anneal = dcure * 0.12;
                F = F * (1.0 - anneal) + R * anneal;
                svd = svd2x2(F);
                R = svd.U * transpose(svd.V);
                J = svd.sigma.x * svd.sigma.y;
            }
        }
        damage[idx] = cured;

        float thermal_drive = clamp((temp - 540.0) / 170.0, 0.0, 1.0);
        bloom += clamp(thermal_drive - bloom, -0.5 * u_dt, 2.8 * u_dt);
        bloom = clamp(bloom, 0.0, 1.0);
        phase_data[idx] = bloom;

        vec2 fiber = normalize(fiber_dirs[idx] + vec2(1e-6, 0.0));
        vec2 df = F * fiber;
        float fs = length(df);
        vec2 perp = vec2(-fiber.y, fiber.x);
        float perp_strain = abs(length(F * perp) - 1.0);
        float along_strain = abs(fs - 1.0);

        float E_s = E * (1.1 + cured * 5.6);
        float mu_s = E_s / (2.0 * (1.0 + nu));
        float lam_s = E_s * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));
        float J_rest = 1.0 + cured * 0.015 - bloom * 0.05;

        stress = 2.0 * mu_s * (F - R) * transpose(F)
               + lam_s * (J - J_rest) * J * mat2(1.0);

        if (fs > 1e-6) {
            vec2 fh = df / fs;
            float fi = clamp(fs - 1.0, -0.25, 0.35);
            stress += fiber_strength * mu_s * (1.0 + cured * 0.8) * fi * mat2(
                fh.x*fh.x, fh.x*fh.y, fh.y*fh.x, fh.y*fh.y);
        }

        float self_split = max(bloom * cured - 0.28, 0.0);
        float crack_drive = max(perp_strain * 1.8 + self_split * 0.55 - along_strain * 0.2 - 0.04, 0.0);
        crack += crack_drive * (3.8 + bloom * 5.0) * u_dt;
        crack = clamp(crack, 0.0, 1.0);
        Jp_data[idx] = crack;

        float matrix_keep = max(1.0 - crack * 0.82, 0.16);
        stress *= matrix_keep;
        if (crack > 0.28) {
            float split = smoothstep(0.28, 1.0, crack);
            stress *= mix(1.0, 0.08, split);
        }
    }
    else if (mat_type == MAT_BREAD) {
        float baked = damage[idx];
        float gas = phase_data[idx];
        float tear = Jp_data[idx];

        if (temp > 340.0) {
            gas += 2.2 * u_dt * clamp((temp - 340.0) / 180.0, 0.0, 1.0) * (1.0 - gas) * mix(1.0, 0.75, baked);
        } else {
            gas += (0.0 - gas) * 0.16 * u_dt;
        }
        gas = clamp(gas, 0.0, 1.0);

        if (temp > (use_bp ? bpA.x : 385.0)) {
            float prev = baked;
            baked += (use_bp ? bpA.z : 0.55) * u_dt * clamp((temp - (use_bp ? bpA.x : 385.0)) / (use_bp ? bpB.y : 220.0), 0.0, 1.0) * (1.0 - baked);
            baked = clamp(baked, 0.0, 1.0);
            float dbake = baked - prev;
            if (dbake > 0.0) {
                float anneal = dbake * 0.10;
                F = F * (1.0 - anneal) + R * anneal;
                svd = svd2x2(F);
                R = svd.U * transpose(svd.V);
                J = svd.sigma.x * svd.sigma.y;
            }
        }

        float warm_soft = smoothstep(340.0, 560.0, temp);
        float crumb_set = smoothstep(0.16, 0.70, gas) * smoothstep(0.10, 0.85, baked);
        float E_d = E * mix(use_bp ? bpB.z : 1.20, use_bp ? bpB.w : 2.25, baked) * mix(1.0, 0.90, warm_soft) * (1.0 + crumb_set * 2.1);
        float nu_d = clamp(mix(0.33, 0.27, baked), 0.16, 0.38);
        float mu_d = E_d / (2.0 * (1.0 + nu_d));
        float lam_d = E_d * nu_d / ((1.0 + nu_d) * (1.0 - 2.0 * nu_d));
        // Match crust_dough / steam_bun: gas-inflated J_rest benefits from 2.5D depth so
        // plain bread doesn't starve for the pseudo-thickness reinforcement the other
        // baking materials already get.
        float J_rest = 1.0 + gas * (use_bp ? (bpA.y * bpB.x) : mix(0.24, 0.36, baked)) * (1.0 + 0.22 * pseudo_depth)
                           - baked * 0.02 - crumb_set * 0.015;
        if (use_bp) J_rest = clamp(J_rest, 0.74, 3.0);

        stress = 2.0 * mu_d * (F - R) * transpose(F)
               + lam_d * (J - J_rest) * J * mat2(1.0);
        stress += gas * mu_d * mix(0.10, 0.04, crumb_set) * (C + transpose(C));

        // Bake v2: at rest a risen loaf sits at sigma ~ sqrt(J_rest) (~1.17),
        // so measuring tension against 1.0 makes intended inflation read as
        // tensile damage and the loaf tears itself with no external load.
        float rest_stretch_bd = (u_bake_v2 == 1) ? sqrt(max(J_rest, 0.25)) : 1.0;
        float tensile = max(max(svd.sigma.x, svd.sigma.y) / rest_stretch_bd - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y);
        float tear_thresh = (mix(0.36, use_bp ? bpA.w : 0.20, baked) + crumb_set * 0.08) * pseudo_enclosure_hold;
        float tear_rate = mix(0.18, 1.55, baked) * (1.0 + gas * 0.9) / pseudo_split_hold;
        float gas_tear_bd = (u_bake_v2 == 1) ? 0.0 : gas * (0.18 + baked * 0.14);
        float tear_drive = max(tensile * 1.00 + shear * 0.78 + gas_tear_bd - tear_thresh, 0.0);
        tear += tear_drive * tear_rate * u_dt;
        tear = clamp(tear, 0.0, 1.0);
        if (tear > 0.62) gas *= max(1.0 - 1.1 * u_dt, 0.0);

        damage[idx] = baked;
        phase_data[idx] = gas;
        Jp_data[idx] = tear;

        stress *= max(1.0 - tear * 0.60, 0.34);
        if (tear > 0.42) {
            float vent = smoothstep(0.42, 1.0, tear);
            stress *= mix(1.0, 0.32, vent);
        }
    }
    else if (mat_type == MAT_PUFF_CLAY) {
        float cured = damage[idx];
        float gas = phase_data[idx];
        float crack = Jp_data[idx];

        if (temp > 425.0) {
            float prev = cured;
            cured += 0.75 * u_dt * clamp((temp - 425.0) / 190.0, 0.0, 1.0);
            cured = clamp(cured, 0.0, 1.0);
            float dcure = cured - prev;
            if (dcure > 0.0) {
                float anneal = dcure * 0.14;
                F = F * (1.0 - anneal) + R * anneal;
                svd = svd2x2(F);
                R = svd.U * transpose(svd.V);
                J = svd.sigma.x * svd.sigma.y;
            }
        }

        float target_gas = clamp((temp - 535.0) / 180.0, 0.0, 1.0) * clamp(cured * 1.25 - 0.12, 0.0, 1.0);
        gas += clamp(target_gas - gas, -0.25 * u_dt, 2.2 * u_dt);
        gas = clamp(gas, 0.0, 1.0);

        float E_pc = E * (1.0 + cured * 4.8) * mix(1.0, 0.72, gas);
        float nu_pc = clamp(mix(nu, 0.31, gas), 0.14, 0.35);
        float mu_pc = E_pc / (2.0 * (1.0 + nu_pc));
        float lam_pc = E_pc * nu_pc / ((1.0 + nu_pc) * (1.0 - 2.0 * nu_pc));
        float J_rest = 1.0 + gas * (0.14 + 0.10 * cured);

        stress = 2.0 * mu_pc * (F - R) * transpose(F)
               + lam_pc * (J - J_rest) * J * mat2(1.0);

        float rest_stretch_pc = (u_bake_v2 == 1) ? sqrt(max(J_rest, 0.25)) : 1.0;
        float tensile = max(max(svd.sigma.x, svd.sigma.y) / rest_stretch_pc - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y);
        float crack_thresh = mix(0.16, 0.05, cured) * (1.0 - gas * 0.28);
        float crack_rate = mix(0.8, 5.6, cured) * (1.0 + gas * 2.2);
        float gas_crack_pc = (u_bake_v2 == 1) ? 0.0 : gas * (0.28 + cured * 0.40);
        float crack_drive = max(tensile * 1.25 + shear * 1.65 + gas_crack_pc - crack_thresh, 0.0);
        crack += crack_drive * crack_rate * u_dt;
        crack = clamp(crack, 0.0, 1.0);
        if (crack > 0.35) gas *= max(1.0 - 1.2 * u_dt, 0.0);

        damage[idx] = cured;
        phase_data[idx] = gas;
        Jp_data[idx] = crack;

        stress *= max(1.0 - crack * 0.60, 0.20);
        if (crack > 0.32) {
            float crumble = smoothstep(0.32, 1.0, crack);
            stress *= mix(1.0, 0.10, crumble);
        }
    }
    else if (mat_type == MAT_FIRECRACKER) {
        float fuse = damage[idx];
        float gas = phase_data[idx];
        float crack = Jp_data[idx];
        float batch_heat = max(thermal_params.y, 0.1);
        float batch_cooling = max(thermal_params.z, 0.02);
        float batch_loft = max(thermal_params.w, 0.0);

        if (temp > 340.0 && fuse < 1.0) {
            float ignite_rate = mix(2.35, 1.05, shell_seed) * mix(0.82, 1.22, clamp(batch_cooling, 0.0, 1.2));
            fuse += ignite_rate * u_dt * clamp((temp - 340.0) / 170.0, 0.0, 1.0);
        }
        if (fuse > 0.03 && fuse < 0.985) {
            temp += (1480.0 + 260.0 * batch_heat) * clamp(fuse * (1.0 - fuse) * 4.0, 0.0, 1.0) * u_dt;
        }
        fuse = clamp(fuse, 0.0, 1.0);
        temperatures[p] = clamp(temp, 0.0, 1400.0);

        float target_gas = clamp((fuse - mix(0.10, 0.22, shell_seed)) / mix(0.18, 0.44, shell_seed), 0.0, 1.0)
                         * mix(1.18, 0.56, shell_seed);
        gas += clamp(target_gas - gas, -0.18 * u_dt, 14.0 * u_dt);
        gas = clamp(gas, 0.0, 1.0);

        float sealed = 1.0 - smoothstep(mix(0.18, 0.32, shell_seed), mix(0.62, 0.78, shell_seed), crack);
        float pressure = gas * sealed * mix(1.45, 0.78, shell_seed);
        float E_fc = E * mix(1.10, 0.78, fuse) * mix(1.0, 1.45, shell_seed * (1.0 - crack));
        float mu_fc = E_fc / (2.0 * (1.0 + nu));
        float lam_fc = E_fc * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));
        float J_rest = 1.0 + pressure * (0.62 + 0.10 * core_seed) + gas * 0.08 - shell_seed * fuse * 0.04;

        stress = 2.0 * mu_fc * (F - R) * transpose(F)
               + lam_fc * (J - J_rest) * J * mat2(1.0);
        if (pressure > 0.02) {
            stress += mat2(pressure * mu_fc * (0.22 + 0.20 * core_seed));
        }

        float tensile = max(max(svd.sigma.x, svd.sigma.y) - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y);
        float crack_drive = max(tensile * 1.10 + shear * 1.45 + pressure * (2.30 + fuse * 4.8) - mix(0.09, 0.04, core_seed), 0.0);
        if (fuse > mix(0.22, 0.14, core_seed)) {
            crack += crack_drive * (1.4 + pressure * 42.0) * u_dt;
        }
        crack = clamp(crack, 0.0, 1.0);

        float vent = smoothstep(0.56, 0.96, crack) * smoothstep(0.36, 0.96, pressure);
        if (vent > 0.001) {
            float h0 = hash1(vec2(float(p) * 0.6180339 + fuse * 31.7,
                                  float(idx) * 1.173 + gas * 17.3));
            // Use angle-based random direction (guaranteed uniform on circle)
            float angle = h0 * 6.28318;
            vec2 burst_dir = vec2(cos(angle), sin(angle));
            float burst_speed = vent * mix(14.0, 46.0, pressure) * mix(1.0, 0.58, shell_seed);
            vel += burst_dir * burst_speed;
            gas *= max(1.0 - vent * 0.94, 0.0);
            C *= max(1.0 - vent * 0.82, 0.04);
            temp = max(temp, 680.0 + 220.0 * pressure + 120.0 * batch_loft);
        }

        damage[idx] = fuse;
        phase_data[idx] = gas;
        Jp_data[idx] = crack;

        stress *= max(1.0 - crack * 0.96, 0.02);
        if (crack > 0.30) {
            float burst = smoothstep(0.30, 1.0, crack);
            stress *= mix(1.0, 0.02, burst);
            mat2 F_iso = mat2(sqrt(max(J, 0.01)));
            F = F * (1.0 - burst * 0.22) + F_iso * (burst * 0.22);
        }
    }
    else if (mat_type == MAT_GLAZE_CLAY) {
        float cured = damage[idx];
        float glaze = phase_data[idx];
        float crack = Jp_data[idx];

        if (temp > 380.0) {
            float prev = cured;
            float cure_rate = mix(0.28, 1.20, shell_seed) * clamp((temp - 380.0) / 230.0, 0.0, 1.0);
            cured += cure_rate * u_dt * (1.0 - cured);
            cured = clamp(cured, 0.0, 1.0);
            float dcure = cured - prev;
            if (dcure > 0.0) {
                float anneal = dcure * mix(0.06, 0.18, shell_seed);
                F = F * (1.0 - anneal) + R * anneal;
                svd = svd2x2(F);
                R = svd.U * transpose(svd.V);
                J = svd.sigma.x * svd.sigma.y;
            }
        }

        float target_glaze = shell_seed * clamp((temp - 610.0) / 190.0, 0.0, 1.0) * smoothstep(0.35, 0.85, cured);
        glaze += clamp(target_glaze - glaze, -0.24 * u_dt, 1.35 * u_dt);
        glaze = clamp(glaze, 0.0, 1.0);

        float shell_shrink = shell_seed * cured * 0.055 + shell_seed * clamp((temp - 430.0) / 260.0, 0.0, 1.0) * 0.015;
        float core_swelling = core_seed * clamp((temp - 460.0) / 220.0, 0.0, 1.0) * (1.0 - cured) * 0.045;
        float glaze_flow = glaze * shell_seed * clamp((temp - 700.0) / 220.0, 0.0, 1.0) * 0.02;

        float E_gc = E * mix(0.85, 4.8, cured) * mix(1.0, 0.72, glaze * shell_seed);
        float nu_gc = clamp(mix(nu, 0.32, glaze * shell_seed), 0.12, 0.36);
        float mu_gc = E_gc / (2.0 * (1.0 + nu_gc));
        float lam_gc = E_gc * nu_gc / ((1.0 + nu_gc) * (1.0 - 2.0 * nu_gc));
        float J_rest = 1.0 - shell_shrink + core_swelling + glaze_flow;

        stress = 2.0 * mu_gc * (F - R) * transpose(F)
               + lam_gc * (J - J_rest) * J * mat2(1.0);
        if (glaze > 0.04) {
            stress += shell_seed * glaze * mu_gc * 0.18 * (C + transpose(C));
        }

        float tensile = max(max(svd.sigma.x, svd.sigma.y) - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y);
        float mismatch = abs(shell_shrink - core_swelling) + glaze * shell_seed * 0.08;
        float crack_thresh = mix(0.18, 0.07, cured) * mix(1.0, 0.82, shell_seed);
        float crack_rate = mix(0.35, 3.4, cured) * (1.0 + shell_seed * 1.5 + glaze);
        float crack_drive = max(tensile * 1.15 + shear * 1.25 + mismatch - crack_thresh, 0.0);
        crack += crack_drive * crack_rate * u_dt;
        crack = clamp(crack, 0.0, 1.0);

        damage[idx] = cured;
        phase_data[idx] = glaze;
        Jp_data[idx] = crack;

        stress *= max(1.0 - crack * 0.58, 0.24);
        if (crack > 0.38) {
            float shard = smoothstep(0.38, 1.0, crack);
            stress *= mix(1.0, 0.18, shard);
        }
    }
    else if (mat_type == MAT_GLAZE_DRIP) {
        float cured = damage[idx];
        float glaze = phase_data[idx];
        float crack = Jp_data[idx];

        if (temp > 360.0) {
            float prev = cured;
            float cure_rate = mix(0.22, 0.95, shell_seed) * clamp((temp - 360.0) / 240.0, 0.0, 1.0);
            cured += cure_rate * u_dt * (1.0 - cured);
            cured = clamp(cured, 0.0, 1.0);
            float dcure = cured - prev;
            if (dcure > 0.0) {
                float anneal = dcure * mix(0.05, 0.14, shell_seed);
                F = F * (1.0 - anneal) + R * anneal;
                svd = svd2x2(F);
                R = svd.U * transpose(svd.V);
                J = svd.sigma.x * svd.sigma.y;
            }
        }

        float target_glaze = shell_seed * clamp((temp - 560.0) / 150.0, 0.0, 1.0) * smoothstep(0.20, 0.70, cured);
        glaze += clamp(target_glaze - glaze, -0.18 * u_dt, 1.90 * u_dt);
        glaze = clamp(glaze, 0.0, 1.0);

        float shell_shrink = shell_seed * cured * 0.035;
        float core_swelling = core_seed * clamp((temp - 470.0) / 220.0, 0.0, 1.0) * (1.0 - cured) * 0.03;
        float E_gd = E * mix(0.80, 3.20, cured) * mix(1.0, 0.24, glaze * shell_seed);
        float nu_gd = clamp(mix(nu, 0.34, glaze * shell_seed), 0.16, 0.39);
        float mu_gd = E_gd / (2.0 * (1.0 + nu_gd));
        float lam_gd = E_gd * nu_gd / ((1.0 + nu_gd) * (1.0 - 2.0 * nu_gd));
        float J_rest = 1.0 - shell_shrink + core_swelling + glaze * shell_seed * 0.045;

        stress = 2.0 * mu_gd * (F - R) * transpose(F)
               + lam_gd * (J - J_rest) * J * mat2(1.0);
        if (glaze > 0.04) {
            stress += shell_seed * glaze * mu_gd * 0.36 * (C + transpose(C));
        }
        if (glaze > 0.30) {
            float relax = shell_seed * smoothstep(0.30, 1.0, glaze) * 0.022;
            mat2 F_iso = mat2(sqrt(max(J, 0.01)));
            F = F * (1.0 - relax) + F_iso * relax;
        }

        float tensile = max(max(svd.sigma.x, svd.sigma.y) - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y);
        float mismatch = abs(shell_shrink - core_swelling) * 0.8 + glaze * shell_seed * 0.04;
        float crack_thresh = mix(0.22, 0.10, cured) * (1.0 + glaze * 0.25);
        float crack_rate = mix(0.18, 1.80, cured) * (1.0 + shell_seed * 0.8);
        float crack_drive = max(tensile * 1.00 + shear * 0.90 + mismatch - crack_thresh, 0.0);
        crack += crack_drive * crack_rate * u_dt;
        crack = clamp(crack, 0.0, 1.0);

        damage[idx] = cured;
        phase_data[idx] = glaze;
        Jp_data[idx] = crack;

        stress *= max(1.0 - crack * 0.50, 0.22);
        if (crack > 0.55) {
            float shard = smoothstep(0.55, 1.0, crack);
            stress *= mix(1.0, 0.24, shard);
        }
    }
    else if (mat_type == MAT_CRUST_DOUGH) {
        float crust = damage[idx];
        float gas = phase_data[idx];
        float tear = Jp_data[idx];

        float gas_source = clamp((temp - 345.0) / 165.0, 0.0, 1.0) * mix(1.8, 0.12, shell_seed) * (1.0 - crust * 0.25);
        gas += gas_source * 2.2 * u_dt * (1.0 - gas);
        if (temp < 335.0) {
            gas += (0.0 - gas) * 0.10 * u_dt / pseudo_enclosure_hold;
        }
        gas = clamp(gas, 0.0, 1.0);

        if (temp > (use_bp ? bpA.x : 370.0)) {
            float prev = crust;
            float crust_rate = mix(0.18, (use_bp ? bpA.z : 1.40), shell_seed) * clamp((temp - (use_bp ? bpA.x : 370.0)) / (use_bp ? bpB.y : 220.0), 0.0, 1.0);
            crust += crust_rate * u_dt * (1.0 - crust);
            crust = clamp(crust, 0.0, 1.0);
            float dcrust = crust - prev;
            if (dcrust > 0.0 && u_porous_growth_v3 == 0) {
                float anneal = dcrust * mix(0.04, 0.10, shell_seed);
                F = F * (1.0 - anneal) + R * anneal;
                svd = svd2x2(F);
                R = svd.U * transpose(svd.V);
                J = svd.sigma.x * svd.sigma.y;
            }
        }

        float warm_soft = smoothstep(340.0, 560.0, temp);
        float crumb_set = smoothstep(0.14, 0.72, gas) * smoothstep(0.12, 0.90, crust);
        float shell_stiff = mix((use_bp ? bpB.z : 1.20), (use_bp ? bpB.w : 6.80), crust * shell_seed) * mix(1.0, pseudo_shell_boost, 0.24 + crust * 0.48);
        float core_soft = mix(1.0, 0.90, warm_soft * core_seed);
        float crumb_scaffold = (1.0 + crumb_set * mix(0.85, 0.30, shell_seed))
                             * (1.0 + pseudo_depth * (0.08 + crumb_set * 0.34));
        float E_cd = E * shell_stiff * core_soft * crumb_scaffold * mix(0.96, 1.10, shell_seed);
        float nu_cd = clamp(mix(0.32, 0.22, crust * shell_seed), 0.16, 0.38);
        float mu_cd = E_cd / (2.0 * (1.0 + nu_cd));
        float lam_cd = E_cd * nu_cd / ((1.0 + nu_cd) * (1.0 - 2.0 * nu_cd));
        float J_rest = 1.0 + gas * (use_bp ? (bpA.y * bpB.x) : (0.30 + 0.18 * core_seed)) * (1.0 + 0.30 * pseudo_depth * core_seed)
                            - shell_seed * crust * 0.028 - crust * 0.012 - crumb_set * 0.02;
        if (use_bp) J_rest = clamp(J_rest, 0.74, 3.0);

        stress = 2.0 * mu_cd * (F - R) * transpose(F)
               + lam_cd * (J - J_rest) * J * mat2(1.0);
        if (u_porous_growth_v3 == 1)
            stress = porous_growth_stress(F, R, J, J_rest, mu_cd, lam_cd);
        stress += core_seed * gas * mu_cd * mix(0.11, 0.05, crumb_set) * (C + transpose(C));

        float rest_stretch_cd = (u_bake_v2 == 1 || u_porous_growth_v3 == 1) ? sqrt(max(J_rest, 0.25)) : 1.0;
        float tensile = max(max(svd.sigma.x, svd.sigma.y) / rest_stretch_cd - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y) / ((u_porous_growth_v3 == 1) ? rest_stretch_cd : 1.0);
        float mismatch = shell_seed * crust * 0.04 + core_seed * gas * 0.07;
        float tear_thresh = (mix(0.40, (use_bp ? bpA.w : 0.18), crust) * mix(1.0, 0.94, shell_seed) + crumb_set * 0.10) * pseudo_enclosure_hold
                          + pseudo_cohesion * (0.05 + 0.04 * crust);
        float tear_rate = mix(0.16, 1.65, crust) * (1.0 + gas * 1.0) / pseudo_split_hold;
        float tear_drive = max(tensile * 0.92 + shear * 0.72 + mismatch - tear_thresh, 0.0);
        tear += tear_drive * tear_rate * u_dt;
        tear = clamp(tear, 0.0, 1.0);
        if (tear > 0.60) {
            gas *= max(1.0 - 1.1 * u_dt / pseudo_enclosure_hold, 0.0);
        }

        damage[idx] = crust;
        phase_data[idx] = gas;
        Jp_data[idx] = tear;

        float tear_soften = mix(0.56, 0.38, clamp(pseudo_cohesion * 0.65, 0.0, 1.0));
        stress *= max(1.0 - tear * tear_soften, 0.42);
        if (tear > 0.40) {
            float vent = smoothstep(0.40, 1.0, tear);
            stress *= mix(1.0, mix(0.38, 0.60, clamp(pseudo_cohesion * 0.8, 0.0, 1.0)), vent);
        }
    }
    else if (mat_type == MAT_STEAM_BUN) {
        float skin = damage[idx];
        float gas = phase_data[idx];
        float tear = Jp_data[idx];

        float gas_source = clamp((temp - 335.0) / 170.0, 0.0, 1.0) * mix(2.1, 0.40, shell_seed) * (1.0 - skin * 0.15);
        gas += gas_source * 2.4 * u_dt * (1.0 - gas);
        if (temp < 330.0) {
            gas += (0.0 - gas) * 0.08 * u_dt / pseudo_enclosure_hold;
        }
        gas = clamp(gas, 0.0, 1.0);

        if (temp > (use_bp ? bpA.x : 385.0)) {
            float prev = skin;
            float skin_rate = mix(0.08, (use_bp ? bpA.z : 0.65), shell_seed) * clamp((temp - (use_bp ? bpA.x : 385.0)) / (use_bp ? bpB.y : 210.0), 0.0, 1.0);
            skin += skin_rate * u_dt * (1.0 - skin);
            skin = clamp(skin, 0.0, 1.0);
            float dskin = skin - prev;
            if (dskin > 0.0 && u_porous_growth_v3 == 0) {
                float anneal = dskin * mix(0.03, 0.08, shell_seed);
                F = F * (1.0 - anneal) + R * anneal;
                svd = svd2x2(F);
                R = svd.U * transpose(svd.V);
                J = svd.sigma.x * svd.sigma.y;
            }
        }

        float warm_soft = smoothstep(340.0, 540.0, temp);
        float crumb_set = smoothstep(0.18, 0.75, gas) * smoothstep(0.08, 0.75, skin);
        float shell_stiff = mix(1.0, 2.8, skin * shell_seed) * mix(1.0, pseudo_shell_boost, 0.18 + skin * 0.40);
        float crumb_scaffold = (1.0 + crumb_set * mix(1.35, 0.55, shell_seed))
                             * (1.0 + pseudo_depth * (0.06 + crumb_set * 0.30));
        float E_sb = E * mix((use_bp ? bpB.z : 1.15), (use_bp ? bpB.w : 1.95), skin) * shell_stiff * mix(1.0, 0.92, warm_soft) * crumb_scaffold;
        float nu_sb = clamp(mix(0.31, 0.24, skin), 0.16, 0.36);
        float mu_sb = E_sb / (2.0 * (1.0 + nu_sb));
        float lam_sb = E_sb * nu_sb / ((1.0 + nu_sb) * (1.0 - 2.0 * nu_sb));
        float J_rest = 1.0 + gas * ((use_bp ? (bpA.y * bpB.x) : 0.34) + 0.14 * core_seed) * (1.0 + 0.28 * pseudo_depth * core_seed)
                            - shell_seed * skin * 0.016 - crumb_set * 0.010;
        if (use_bp) J_rest = clamp(J_rest, 0.74, 3.0);

        stress = 2.0 * mu_sb * (F - R) * transpose(F)
               + lam_sb * (J - J_rest) * J * mat2(1.0);
        if (u_porous_growth_v3 == 1)
            stress = porous_growth_stress(F, R, J, J_rest, mu_sb, lam_sb);
        stress += core_seed * gas * mu_sb * mix(0.12, 0.05, crumb_set) * (C + transpose(C));

        float rest_stretch_sb = (u_bake_v2 == 1 || u_porous_growth_v3 == 1) ? sqrt(max(J_rest, 0.25)) : 1.0;
        float tensile = max(max(svd.sigma.x, svd.sigma.y) / rest_stretch_sb - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y) / ((u_porous_growth_v3 == 1) ? rest_stretch_sb : 1.0);
        float mismatch = shell_seed * skin * 0.03 + core_seed * gas * 0.06;
        float tear_thresh = (mix(0.44, (use_bp ? bpA.w : 0.26), skin) + crumb_set * 0.12) * pseudo_enclosure_hold
                          + pseudo_cohesion * (0.05 + 0.03 * skin);
        float tear_rate = mix(0.10, 1.20, skin) * (1.0 + gas * 0.7) / pseudo_split_hold;
        float tear_drive = max(tensile * 0.88 + shear * 0.65 + mismatch - tear_thresh, 0.0);
        tear += tear_drive * tear_rate * u_dt;
        tear = clamp(tear, 0.0, 1.0);
        if (tear > 0.70) {
            gas *= max(1.0 - 0.9 * u_dt / pseudo_enclosure_hold, 0.0);
        }

        damage[idx] = skin;
        phase_data[idx] = gas;
        Jp_data[idx] = tear;

        float bun_soften = mix(0.42, 0.28, clamp(pseudo_cohesion * 0.65, 0.0, 1.0));
        stress *= max(1.0 - tear * bun_soften, 0.52);
        if (tear > 0.50) {
            float vent = smoothstep(0.50, 1.0, tear);
            stress *= mix(1.0, mix(0.50, 0.66, clamp(pseudo_cohesion * 0.75, 0.0, 1.0)), vent);
        }
    }
    else if (mat_type == MAT_CRUMB_LOAF) {
        float dry = damage[idx];
        float pore = phase_data[idx];
        float tear = Jp_data[idx];
        float micro = hash1(vec2(float(p) * 0.173 + 4.1, float(idx) * 0.071 + 9.7));
        float pore_nuc = mix(0.72, 1.28, micro);
        float vent_bias = mix(0.92, 1.18, micro);

        if (temp > (use_bp ? bpA.x : 350.0)) {
            float prev = dry;
            float dry_rate = mix(0.10, (use_bp ? bpA.z : 0.95), shell_seed) * clamp((temp - (use_bp ? bpA.x : 350.0)) / (use_bp ? bpB.y : 210.0), 0.0, 1.0);
            dry += dry_rate * u_dt * (1.0 - dry);
            dry = clamp(dry, 0.0, 1.0);
            float ddry = dry - prev;
            if (ddry > 0.0 && u_porous_growth_v3 == 0) {
                float anneal = ddry * mix(0.03, 0.08, shell_seed);
                F = F * (1.0 - anneal) + R * anneal;
                svd = svd2x2(F);
                R = svd.U * transpose(svd.V);
                J = svd.sigma.x * svd.sigma.y;
            }
        }

        float pore_target = smoothstep(338.0, 520.0, temp) * (1.0 - dry * 0.68) * mix(1.32, 0.78, shell_seed) * pore_nuc
                          * (1.0 + 0.22 * pseudo_depth * core_seed);
        pore += clamp(pore_target - pore, -0.06 * u_dt, 1.90 * u_dt);
        pore = clamp(pore, 0.0, 1.0);

        float scaffold = smoothstep(0.18, 0.72, pore) * smoothstep(0.22, 0.82, dry);
        float warm_soft = smoothstep(345.0, 560.0, temp);
        float E_cl = E * mix((use_bp ? bpB.z : 1.10), (use_bp ? bpB.w : 2.65), dry) * mix(1.0, 0.84, warm_soft * 0.38)
                       * mix(1.0, 0.82, smoothstep(0.62, 1.0, pore))
                       * (1.0 + scaffold * 3.4)
                       * (1.0 + pseudo_depth * (0.10 + scaffold * 0.30))
                       * mix(1.0, pseudo_shell_boost, 0.10 + 0.25 * dry);
        float nu_cl = clamp(mix(0.33, 0.23, dry), 0.16, 0.39);
        float mu_cl = E_cl / (2.0 * (1.0 + nu_cl));
        float lam_cl = E_cl * nu_cl / ((1.0 + nu_cl) * (1.0 - 2.0 * nu_cl));
        float shell_shrink = shell_seed * dry * 0.026;
        float pore_lift = pore * ((use_bp ? (bpA.y * bpB.x) : 0.28) + 0.16 * core_seed) * (1.0 + 0.34 * pseudo_depth * core_seed);
        float vent_relax = smoothstep(0.60, 1.0, tear) * pore * 0.035;
        float J_rest = 1.0 + pore_lift - shell_shrink - dry * 0.006 - vent_relax;

        stress = 2.0 * mu_cl * (F - R) * transpose(F)
               + lam_cl * (J - J_rest) * J * mat2(1.0);
        if (u_porous_growth_v3 == 1)
            stress = porous_growth_stress(F, R, J, J_rest, mu_cl, lam_cl);
        stress += pore * mu_cl * mix(0.14, 0.06, scaffold) * (C + transpose(C));

        float rest_stretch_cl = (u_porous_growth_v3 == 1) ? sqrt(max(J_rest, 0.25)) : 1.0;
        float tensile = max(max(svd.sigma.x, svd.sigma.y) / rest_stretch_cl - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y) / rest_stretch_cl;
        float mismatch = shell_seed * dry * 0.05 + core_seed * pore * 0.08;
        float tear_thresh = (mix(0.42, (use_bp ? bpA.w : 0.18), dry) + scaffold * 0.10) * mix(1.08, 0.84, micro) * pseudo_enclosure_hold
                          + pseudo_cohesion * (0.06 + 0.05 * scaffold);
        float tear_rate = mix(0.12, 1.90, dry) * (1.0 + pore * 1.4) / pseudo_split_hold;
        float tear_drive = max(tensile * 0.95 + shear * 0.78 + mismatch + pore * (0.16 + 0.08 * vent_bias) - tear_thresh, 0.0);
        if (u_porous_growth_v3 == 1)
            tear_drive = max(tensile * 0.95 + shear * 0.78 + mismatch - tear_thresh, 0.0);
        tear += tear_drive * tear_rate * u_dt;
        tear = clamp(tear, 0.0, 1.0);
        if (tear > 0.56) {
            pore *= max(1.0 - (0.88 + 0.22 * vent_bias) * u_dt / pseudo_enclosure_hold, 0.0);
        }

        damage[idx] = dry;
        phase_data[idx] = pore;
        Jp_data[idx] = tear;

        float crumb_soften = mix(0.38, 0.26, clamp(pseudo_cohesion * 0.7, 0.0, 1.0));
        stress *= max(1.0 - tear * crumb_soften, 0.54);
        if (tear > 0.48) {
            float vent = smoothstep(0.48, 1.0, tear);
            stress *= mix(1.0, mix(0.58, 0.72, clamp(pseudo_cohesion * 0.8, 0.0, 1.0)), vent);
        }
    }
    else if (mat_type == MAT_BISQUE) {
        float sinter = damage[idx];
        float pore = phase_data[idx];
        float crack = Jp_data[idx];
        float micro = hash1(vec2(float(p) * 0.147 + 1.3, float(idx) * 0.119 + 3.7));
        float burnout_bias = mix(0.82, 1.24, micro);

        if (temp > (use_bp ? bpA.x : 410.0)) {
            float prev = sinter;
            float sinter_rate = mix(0.12, (use_bp ? bpA.z : 1.00), shell_seed) * clamp((temp - (use_bp ? bpA.x : 410.0)) / (use_bp ? bpB.y : 320.0), 0.0, 1.0);
            sinter += sinter_rate * u_dt * (1.0 - sinter);
            sinter = clamp(sinter, 0.0, 1.0);
