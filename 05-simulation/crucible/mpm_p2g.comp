        }

        float delam_drive = max(across * 1.80 + steam * (0.30 + 0.24 * core_seed) - along * 0.18 - (0.16 + bake * 0.06), 0.0);
        delam += delam_drive * (0.18 + steam * 3.4 + bake * 0.55) * u_dt;
        delam = clamp(delam, 0.0, 1.0);

        damage[idx] = bake;
        phase_data[idx] = steam;
        Jp_data[idx] = delam;

