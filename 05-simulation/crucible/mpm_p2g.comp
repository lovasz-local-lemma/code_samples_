            float dry_rate = mix(0.10, 1.18, shell_seed) * clamp((temp - 335.0) / 230.0, 0.0, 1.0);
            dry += dry_rate * u_dt * (1.0 - dry);
            dry = clamp(dry, 0.0, 1.0);
