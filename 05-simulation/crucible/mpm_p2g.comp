        float heat = smoothstep(338.0, 560.0, temp);
        float evap = heat * moisture * mix(0.26, 1.18, shell_seed) * mix(0.90, 1.18, micro) / pseudo_enclosure_hold;
        moisture += -evap * u_dt;
