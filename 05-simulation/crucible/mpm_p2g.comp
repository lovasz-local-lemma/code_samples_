        pore += burnout * 0.92 * u_dt * (1.0 - pore);
        pore += (0.0 - pore) * densify * 0.74 * u_dt;
        pore = clamp(pore, 0.0, 1.0);

        float E_bs = E * mix((use_bp ? bpB.z : 0.92), (use_bp ? bpB.w : 6.2), sinter) * mix(1.0, 0.48, pore)
                       * mix(1.0, pseudo_shell_boost, 0.16 + 0.50 * sinter)
                       * (1.0 + pseudo_depth * 0.18);
        float nu_bs = clamp(mix(nu, 0.24, sinter), 0.12, 0.36);
        float mu_bs = E_bs / (2.0 * (1.0 + nu_bs));
        float lam_bs = E_bs * nu_bs / ((1.0 + nu_bs) * (1.0 - 2.0 * nu_bs));
        float shell_shrink = shell_seed * (sinter * (use_bp ? -(bpA.y * bpB.x) : 0.060) + densify * 0.018);
        float pore_swelling = core_seed * pore * 0.055;
        float J_rest = 1.0 + pore_swelling - shell_shrink - sinter * 0.010;

        stress = 2.0 * mu_bs * (F - R) * transpose(F)
               + lam_bs * (J - J_rest) * J * mat2(1.0);

        float tensile = max(max(svd.sigma.x, svd.sigma.y) - 1.0, 0.0);
        float shear = abs(svd.sigma.x - svd.sigma.y);
        float mismatch = abs(shell_shrink - pore_swelling) + pore * 0.04 + shell_seed * sinter * 0.03;
        float crack_thresh = mix(0.22, (use_bp ? bpA.w : 0.06), sinter) * mix(1.08, 0.82, micro) * pseudo_split_hold
                           + pseudo_shell * shell_seed * 0.05;
        float crack_rate = mix(0.20, 3.8, sinter) * (1.0 + pore * 1.6) / pseudo_split_hold;
        float crack_drive = max(tensile * 1.10 + shear * 1.25 + mismatch - crack_thresh, 0.0);
        crack += crack_drive * crack_rate * u_dt;
        crack = clamp(crack, 0.0, 1.0);

        damage[idx] = sinter;
        phase_data[idx] = pore;
        Jp_data[idx] = crack;

        float bisque_soften = mix(0.60, 0.42, clamp(pseudo_cohesion * 0.8, 0.0, 1.0));
        stress *= max(1.0 - crack * bisque_soften, 0.24);
        if (crack > 0.42) {
            float shard = smoothstep(0.42, 1.0, crack);
            stress *= mix(1.0, mix(0.18, 0.34, clamp(pseudo_cohesion * 0.8, 0.0, 1.0)), shard);
